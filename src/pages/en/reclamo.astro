---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import FormClaim from '@/islands/FormClaim'
import AppProvider from '@/layouts/AppProvider'

const pathname = Astro.url.pathname

// ✅ detectamos idioma desde la URL
const locale = pathname.startsWith('/en') ? 'en' : 'es'

// ✅ glob seguro con alias
const dictionaries = import.meta.glob('@/i18n/*.json', { eager: true })

const messages = dictionaries[`/src/i18n/${locale}.json`]?.default ?? {}

const t = (key) => messages[key] ?? key
---

<BaseLayout title="libro de reclamaciones" />

<BaseLayout>
  <Header t={t} />
  <main>
    <section class="section-reclamo">
      <section class="container claim-container">
        <section class="claim-info" aria-labelledby="claim-title">
          <div class="claim-header">
            <h1 id="claim-title" class="gradient-blue-dark">Register Your Claim</h1>
          </div>

          <!-- Company information -->
          <address class="claim-entity">
            <p>
              <strong>Company name:</strong>
              <span>SEIDOR CONSULTING PERU S.A.C.</span>
            </p>
            <p>
              <strong>Tax ID (RUC):</strong>
              <span>20517426726</span>
            </p>
            <p>
              <strong>Registered address:</strong>
              <span> Vittore Carpaccio 250, Office 501, San Borja, Lima, Peru </span>
            </p>
            <p>
              <strong>Contact email:</strong>
              <a href="mailto:ayuda@zcflow.com">ayuda@zcflow.com</a>
            </p>
          </address>

          <!-- Response timeframe -->
          <section class="claim-deadline" aria-labelledby="claim-deadline-title">
            <h2 id="claim-deadline-title" class="sr-only">Response timeframe</h2>
            <p>
              <strong>Response timeframe</strong><br />
              ZCFLOW will respond to the claim or complaint within a maximum period of thirty (30) calendar
              days, in accordance with applicable regulations.
            </p>
          </section>

          <!-- Legal information -->
          <section class="claim-legal" aria-labelledby="claim-legal-title">
            <h2 id="claim-legal-title" class="sr-only">Legal information</h2>

            <article>
              <p>
                Filing a claim or complaint does not prevent the consumer from resorting to other
                dispute resolution mechanisms, nor does it constitute a prerequisite for filing a
                complaint with INDECOPI.
              </p>
            </article>

            <article>
              <h3>Personal data protection</h3>
              <p>
                SEIDOR CONSULTING PERU S.A.C. (hereinafter, “SEIDOR”) informs the user that, in
                accordance with Law No. 29733 – Personal Data Protection Law, its Regulations and
                other supplementary provisions, the personal data provided through ZCFLOW’s
                Complaints Book will be processed under the following conditions:
              </p>

              <p><strong>Purpose of processing and mandatory data</strong></p>
              <p>
                The personal data collected is necessary to receive, manage and respond to the claim
                or complaint submitted by the user.
              </p>
              <p>
                The mandatory personal data includes: first and last names, type and number of
                identity document, home address, telephone number and email address. If this
                information is not provided, SEIDOR will not be able to process or manage the claim
                or complaint.
              </p>

              <p><strong>Recipients and data transfers</strong></p>
              <p>
                Personal data may be processed by data processors solely for the purpose of managing
                the claim or complaint, under strict confidentiality and security obligations.
              </p>

              <p><strong>Database</strong></p>
              <p>
                Personal data will be stored in SEIDOR’s personal data database, duly registered or
                in the process of registration with the National Registry of Personal Data
                Protection.
              </p>

              <p><strong>Retention period</strong></p>
              <p>
                Personal data will be retained for as long as necessary to process and close the
                claim or complaint and, subsequently, for the applicable legal period, up to ten
                (10) years.
              </p>

              <p><strong>Exercise of ARCO rights</strong></p>
              <p>
                The user may exercise their rights of access, rectification, cancellation and
                opposition (ARCO) by submitting a request to the email address
                <a href="mailto:ayuda@zcflow.com">ayuda@zcflow.com</a>.
              </p>

              <p>
                If the user considers that their rights have not been adequately addressed, they may
                file a complaint with the National Authority for Personal Data Protection, under the
                Ministry of Justice and Human Rights.
              </p>
            </article>

            <div class="claim-sign">
              <p>February 2026</p>
            </div>
          </section>
        </section>

        <div class="claim-form">
          <AppProvider client:load>
            <FormClaim client:load />
          </AppProvider>
        </div>
      </section>
    </section>
  </main>
  <Footer t={t} />
</BaseLayout>
