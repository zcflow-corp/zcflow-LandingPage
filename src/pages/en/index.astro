---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/Header.astro'
import Hero from '@/components/Hero.astro'
import Zcflow from '@/components/Zcflow.astro'
import TrustedBy from '@/components/TrustedBy.astro'
import WhatYouCanDo from '@/components/WhatYouCanDo.astro'
import Indicators from '@/components/Indicators.astro'
import Principles from '@/components/Principles.astro'
import CTA from '@/components/CTA.astro'
import ChatBot from '@/components/ChatBot.astro'
import Footer from '@/components/Footer.astro'

const pathname = Astro.url.pathname

// ✅ detectamos idioma desde la URL
const locale = pathname.startsWith('/en') ? 'en' : 'es'

// ✅ glob seguro con alias
const dictionaries = import.meta.glob('@/i18n/*.json', { eager: true })

const messages = dictionaries[`/src/i18n/${locale}.json`]?.default ?? {}

const t = (key) => messages[key] ?? key
---

<BaseLayout>
  <Header t={t} />
  <main>
    <Hero t={t} />
    <Zcflow t={t} />
    <WhatYouCanDo t={t} />
    <Indicators t={t} />
    <ChatBot t={t} />
    <Principles t={t} />
    <CTA t={t} />
  </main>
  <Footer t={t} />
</BaseLayout>
