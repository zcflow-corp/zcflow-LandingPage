
---
import BaseLayout from '@/layouts/BaseLayout.astro'

const pathname = Astro.url.pathname
const locale = pathname.startsWith('/en') ? 'en' : 'es'


const dictionaries = import.meta.glob('../i18n/*.json', { eager: true })

const messages = dictionaries[`../i18n/${locale}.json`]?.default ?? {}

const t = (key) => messages[key] ?? key
---

<BaseLayout>
 
  <main>
    <section class="not-found">
        <h1>404</h1>
        <p>{t('Lo sentimos, la página que buscas no existe')}.</p>
    
        <a href="/" class="btn primary">
          {t('Volver al inicio')}
        </a>
      </section>
  </main>

</BaseLayout>


<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;

    h1 {
    font-size: 6rem;
    margin-bottom: 1rem;
  }

  p {
    font-size: 1.2rem;
    opacity: 0.8;
  }

  .btn {
    margin-top: 2rem;
    padding: 0.75rem 1.5rem;
    /* border-radius: 8px;
    background: ;
    color: white;
    text-decoration: none; */
  }

  }


</style>
