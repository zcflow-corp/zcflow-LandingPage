---
const current = Astro.currentLocale // 'es' | 'en'
const next = current === 'es' ? 'en' : 'es'

const base = import.meta.env.BASE_URL || '/';

const escape = (s:string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

/**limpiar la ruta */
const cleanPath = Astro.url.pathname.replace(new RegExp(`^${escape(base)}(es|en)`), '');

const finalPath = `${base}${next}${cleanPath}`.replace(/\/+/g, '/')
---

<a
  href={finalPath}
  class="btn"
  aria-label={current === 'es' ? 'Cambiar a inglés' : 'Switch to Spanish'}
>
  {current === 'es' ? '🇺🇸' : '🇪🇸'}
</a>
