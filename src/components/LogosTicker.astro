---
// LogosTicker.astro
import IconoSvg from 'src/islands/IconoSVG.jsx'

interface Item {
  name: string
  title?: string
  alt?: string
}
interface Props {
  items?: Item[]
  cols?: number
  interval?: number // ms
  grayscale?: boolean
  dimOpacity?: number // 0..1 (si quieres dejar un leve “ghost” puedes subirlo)
}

const {
  items = [],
  cols = 4,
  interval = 1800,
  grayscale = true,
  dimOpacity = 0, // 0 = desaparece del todo. Si quieres que se vea tenue, pon 0.2, 0.3, etc.
} = Astro.props as Props

const count = items.length
---

<div
  class="logos-ticker"
  style={`--cols:${cols}; --dim:${dimOpacity};`}
  data-count={count}
  data-interval={interval}
  data-grayscale={grayscale ? '1' : '0'}
>
  {
    items.map((l, i) => (
      <div class="logo-partners" data-index={i} aria-hidden={i === 0 ? 'false' : 'true'}>
        <IconoSvg name={l.name} />
      </div>
    ))
  }
</div>

<script>
  // Rotación de logos: aparecen / desaparecen uno por uno en loop
  if (typeof window !== 'undefined') {
    const initTicker = (root) => {
      if (!root) return

      const logos = Array.from(root.querySelectorAll('.logo-partners'))
      if (!logos.length) return

      const interval = Number(root.dataset.interval || '1800')
      const count = logos.length

      let current = 0

      // Estado inicial
      logos.forEach((el, i) => {
        if (i === 0) {
          el.classList.add('is-visible')
          el.setAttribute('aria-hidden', 'false')
        } else {
          el.classList.remove('is-visible', 'is-leaving')
          el.setAttribute('aria-hidden', 'true')
        }
      })

      const animLeaveMs = 550 // que coincida aprox. con $anim-leave

      setInterval(() => {
        const currentEl = logos[current]
        const nextIndex = (current + 1) % count
        const nextEl = logos[nextIndex]

        if (!currentEl || !nextEl) return

        // El actual se va (fade-out)
        currentEl.classList.remove('is-visible')
        currentEl.classList.add('is-leaving')
        currentEl.setAttribute('aria-hidden', 'true')

        // Limpia la clase de leaving al final de la animación
        window.setTimeout(() => {
          currentEl.classList.remove('is-leaving')
        }, animLeaveMs)

        // El siguiente entra (fade-in)
        nextEl.classList.add('is-visible')
        nextEl.setAttribute('aria-hidden', 'false')

        current = nextIndex
      }, interval)
    }

    // Soporte para múltiples carousels de logos en la misma página
    const tickers = document.querySelectorAll('.logos-ticker[data-count]')
    tickers.forEach((t) => initTicker(t))
  }
</script>

<style lang="scss">
  // ====== Vars de animación ======
  $anim-dur: 0.5s;
  $anim-leave: 0.6s;
  $scale-off: 0.98;
  $scale-leave: 0.985;

  .logos-ticker {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    align-items: center;

    &.empty {
      color: var(--c-text-muted);
      font-family: var(--font-body);
    }

    // Si quieres modo escala de grises descomenta:
    // &[data-grayscale='1'] {
    //   .logo-partners {
    //     filter: grayscale(100%);
    //
    //     &.is-visible {
    //       filter: grayscale(0%);
    //     }
    //     &.is-leaving {
    //       filter: grayscale(100%) blur(1px);
    //     }
    //   }
    // }
  }

  .logo-partners {
    // Por defecto “apagado”
    opacity: 0.2;
    transform: scale($scale-off);
    color: var(--c-text);
    transition:
      opacity $anim-dur ease,
      transform $anim-dur ease,
      filter $anim-dur ease;
    will-change: opacity, transform, filter;

    &.is-visible {
      opacity: 1;
      transform: scale(1);
      filter: none;
    }

    &.is-leaving {
      opacity: var(--dim, 0); // usa --dim si quieres que quede un ghost tenue
      transform: scale($scale-leave);
      filter: blur(1px);
      transition-duration: $anim-leave;
    }
  }

  @include media(mobile) {
    .logos-ticker {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-partners {
      transition: none !important;
    }
  }
</style>

<!-- BLOQUE GLOBAL SOLO PARA LOS SVG -->
<style is:global lang="scss">
  .logo-partners span svg path {
    fill: var(--c-text);
  }

  html[data-theme='dark'] .logo-partners span svg path {
    fill: var(--c-white);
  }
</style>
