---
import IconoSvg from './IconoSvg.astro'

interface Item {
  name: string
  title?: string
  alt?: string
}
interface Props {
  items?: Item[] // pásalo desde el padre
  cols?: number
  interval?: number // ms
  grayscale?: boolean
  dimOpacity?: number // 0..1
}

const {
  items = [],
  cols = 4,
  interval = 1800,
  grayscale = true,
  dimOpacity = 0.35,
} = Astro.props as Props

const count = items.length
---

<div
  class="logos-ticker"
  style={`--cols:${cols}; --dim:${dimOpacity};`}
  data-count={count}
  data-interval={interval}
  data-grayscale={grayscale ? '1' : '0'}
>
  {
    items.map((l, i) => (
      <div class="logo" data-index={i} aria-hidden={i === 0 ? 'false' : 'true'}>
        <IconoSvg name={l.name} />
      </div>
    ))
  }
</div>

<script>
  // Rotación con animación de salida (is-leaving) + entrada (is-visible)
  ;(() => {
    const root = document.currentScript?.previousElementSibling
    if (!root) return
    const count = Number(root.dataset.count || '0')
    const interval = Number(root.dataset.interval || '1800')
    if (!count) return

    let visible = 0
    let prev = -1
    const nodes = Array.from(root.querySelectorAll('.logo'))

    // estado inicial
    nodes.forEach((n, i) => n.classList.toggle('is-visible', i === 0))

    const apply = () => {
      // sale el anterior
      if (prev >= 0 && prev !== visible) {
        const out = nodes[prev]
        out.classList.remove('is-visible')
        out.classList.add('is-leaving')
        // limpiar clase de salida después del tiempo de transición
        window.setTimeout(() => out.classList.remove('is-leaving'), 600)
      }
      // entra el nuevo
      nodes.forEach((n, i) => {
        n.classList.toggle('is-visible', i === visible)
        n.setAttribute('aria-hidden', i === visible ? 'false' : 'true')
      })
      prev = visible
    }

    const id = window.setInterval(() => {
      visible = (visible + 1) % count
      apply()
    }, interval)

    // Limpieza si el nodo se desmonta
    const obs = new MutationObserver(() => {
      if (!document.body.contains(root)) {
        window.clearInterval(id)
        obs.disconnect()
      }
    })
    obs.observe(document.body, { childList: true, subtree: true })
  })()
</script>

<style lang="scss">
  // ====== Vars de animación ======
  $logos-gap: 1rem;
  $anim-dur: 0.5s;
  $anim-leave: 0.6s; // debe coincidir con setTimeout en <script>
  $scale-off: 0.98;
  $scale-leave: 0.985;

  .logos-ticker {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: $logos-gap;
    width: 100%;
    align-items: center;

    &.empty {
      color: var(--c-text-muted);
      font-family: var(--font-body);
    }

    // Gris si grayscale=true
    &[data-grayscale='1'] {
      .logo {
        filter: grayscale(100%);

        &.is-visible {
          filter: grayscale(100%);
        }
        &.is-leaving {
          filter: grayscale(100%) blur(1px);
        }
      }
    }
  }

  .logo {
    opacity: var(--dim, 0.35);
    transform: scale($scale-off);
    color: var(--c-text);
    transition:
      opacity $anim-dur ease,
      transform $anim-dur ease,
      filter $anim-dur ease;
    will-change: opacity, transform, filter;

    :where(svg) {
      width: 100%;
      max-width: 160px;
      height: auto;
      display: block;
    }

    &.is-visible {
      opacity: 1;
      transform: scale(1);
      filter: none;
    }

    &.is-leaving {
      opacity: var(--dim, 0.35);
      transform: scale($scale-leave);
      filter: blur(1px);
      transition-duration: $anim-leave;
    }
  }

  @include media(mobile) {
    .logos-ticker {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo {
      transition: none !important;
    }
  }
</style>
