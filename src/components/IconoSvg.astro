---
/**
 * Usa: <IconoSvg name="check" />
 * Agrega más iconos pegando su SVG COMPLETO como string en ICONS.
 * No necesitas pasar size/clases: vienen en el propio SVG.
 */

interface Props {
  name: string
}
const { name } = Astro.props as Props

const ICONS: Record<string, string> = {
  // ✅ Check (tu SVG original). Puedes dejar el color fijo o cambiar a currentColor.
  check: `
<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" aria-hidden="true">
  <path stroke="currentColor" stroke-linecap="square" stroke-width=".875"
        d="M12.833 6.467v.537a5.833 5.833 0 1 1-3.46-5.332m3.46.662L6.999 8.173l-1.75-1.75"/>
</svg>`,

  // ✅ Sparkles (solo path)
  sparkles: `
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
  <path d="M12 3l2 5 5 2-5 2-2 5-2-5-5-2 5-2 2-5z" fill="currentColor"/>
</svg>`,

  // ✅ Email
  email: `
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
  <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
  <path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
</svg>`,

  // ✅ Phone
  phone: `
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
  <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 3 5.18 2 2 0 0 1 5 3h3a2 2 0 0 1 2 1.72c.12.9.33 1.77.62 2.6a2 2 0 0 1-.45 2.11l-1.27 1.27a16 16 0 0 0 6.86 6.86l1.27-1.27a2 2 0 0 1 2.11-.45c.83.29 1.7.5 2.6.62A2 2 0 0 1 22 16.92z"
        fill="none" stroke="currentColor" stroke-width="2"/>
</svg>`,

  // ✅ Arrow Right
  'arrow-right': `
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
  <path d="M5 12h14M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>`,

  // ✅ Moon
  moon: `
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
  <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" fill="none" stroke="currentColor" stroke-width="2"/>
</svg>`,

  // ✅ Sun
  sun: `
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
  <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
  <path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"
        fill="none" stroke="currentColor" stroke-width="2"/>
</svg>`,

  integration: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="13" fill="none" viewBox="0 0 18 13">
  <path stroke="#3E76FE" stroke-width="1.25" d="M16.912 5.662c.253.356.38.533.38.796s-.127.44-.38.796c-1.139 1.597-4.046 5.038-7.954 5.038-3.907 0-6.815-3.441-7.953-5.038-.253-.355-.38-.533-.38-.796s.127-.44.38-.796C2.143 4.066 5.051.625 8.958.625c3.908 0 6.815 3.441 7.954 5.037Z"/>
</svg>`,

  ia: `
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 20 20">
  <path stroke="#3E76FE" stroke-linejoin="round" stroke-width="1.25" d="M14.562 7.51h.019a3.753 3.753 0 0 1 3.75 3.756A3.755 3.755 0 0 1 14.997 15m-.435-7.49A4.588 4.588 0 0 0 9.997 2.5a4.587 4.587 0 0 0-4.566 4.193m9.131.816a4.576 4.576 0 0 1-1.029 2.505m-8.102-3.32a4.172 4.172 0 0 0-3.767 4.155 4.174 4.174 0 0 0 3.333 4.09m.434-8.246a4.143 4.143 0 0 1 2.9.816"/>
  <path stroke="#3E76FE" stroke-width="1.25" d="M10 10.833v6.212M7.5 15l2.5 2.5 2.5-2.5"/>
</svg>
`,

  configured: `

<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 20 20">
  <path stroke="#3E76FE" stroke-linecap="round" stroke-width="1.25" d="m17.767 5.95-.411-.713c-.311-.54-.467-.81-.731-.917-.265-.108-.564-.023-1.163.147l-1.017.286a1.66 1.66 0 0 1-1.132-.141l-.28-.162c-.3-.192-.53-.474-.657-.806l-.279-.832c-.183-.55-.274-.825-.492-.982-.218-.157-.507-.157-1.086-.157H9.59c-.578 0-.868 0-1.086.157-.217.157-.309.432-.492.982l-.278.832a1.666 1.666 0 0 1-.657.806l-.28.162c-.35.18-.75.23-1.133.141l-1.017-.286c-.598-.17-.898-.255-1.162-.147-.265.107-.42.377-.731.917l-.412.714c-.291.506-.437.759-.409 1.028.028.27.224.487.614.92l.86.961c.21.266.358.73.358 1.146 0 .417-.149.88-.359 1.146l-.859.96c-.39.435-.586.652-.614.921-.028.27.118.522.41 1.028l.41.714c.312.54.467.81.732.918.264.107.564.022 1.162-.147l1.017-.287a1.66 1.66 0 0 1 1.132.141l.281.162c.3.192.53.475.657.807l.278.83c.183.55.275.826.492.983.218.158.508.158 1.086.158h.93c.578 0 .867 0 1.085-.158.218-.157.31-.432.492-.982l.279-.831c.127-.332.357-.615.656-.807l.28-.162c.35-.179.75-.23 1.133-.14l1.017.286c.599.17.898.254 1.163.147.264-.108.42-.378.73-.918l.412-.714c.292-.506.438-.759.41-1.028-.03-.27-.224-.486-.615-.92l-.859-.961c-.21-.266-.359-.73-.359-1.146 0-.416.15-.88.36-1.146l.858-.96c.39-.434.586-.651.614-.92.029-.27-.117-.523-.409-1.03Z"/>
  <path stroke="#3E76FE" stroke-width="1.25" d="M12.935 10a2.917 2.917 0 1 1-5.833 0 2.917 2.917 0 0 1 5.833 0Z"/>
</svg> `,

  image: `
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
  <circle cx="8.5" cy="8.5" r="1.5"/>
  <polyline points="21 15 16 10 5 21"/>
</svg>`,
}

const key = name.toLowerCase()
const svg = ICONS[key]
if (!svg) {
  throw new Error(`Icono "${key}" no existe en IconoSvg.astro (ICONS).`)
}
---

<!-- Render inline del SVG almacenado como string -->
<span class="icon" aria-hidden="true" set:html={svg} />

<style is:global>
  .icon {
    display: inline-block;
    vertical-align: middle;
    color: currentColor;
  }
  /* Si quieres un tamaño por defecto para TODOS:
     .icon svg { width: 18px; height: 18px; } */
</style>
