---
import { Image } from 'astro:assets'

const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k: unknown) => k
const base = import.meta.env.BASE_URL
---

<footer id="contacto" role="contentinfo" aria-label="Pie de página principal de ZCFlow">
  <div class="container footer-grid">
    <div class="footer-col" itemscope itemtype="https://schema.org/Organization">
      <a href="/inicio" aria-label="Inicio - ZCFlow">
        <Image
          src=`${base}assets/logo_header_light.webp`
          alt="ZCFlow logo light"
          class="responsive-mode-dark"
          width={120}
          height={120}
          loading="lazy"
          decoding="async"
          itemprop="logo"
        />
      </a>
      <meta itemprop="name" content="ZCFlow" />
      <meta itemprop="url" content="https://www.zcflow.com" />
      <p itemprop="description">{t('Predice el futuro, minimiza riesgos.')}</p>
      <small>©2025 Seidor. All rights reserved.</small>
    </div>

    <div class="footer-col">
      <h3>{t('Platform')}</h3>
      <nav aria-label="Platform">
        <a href="#soluciones" target="_blank" rel="noopener noreferrer">{t('Empresas')}</a>
        <a href="#soluciones" target="_blank" rel="noopener noreferrer">{t('Soluciones')}</a>
        <a href="#fundamentos" target="_blank" rel="noopener noreferrer">{t('Fundamentos')}</a>
        <a href="#zcflow" target="_blank" rel="noopener noreferrer">{t('Quiénes somos')}</a>
      </nav>
    </div>

    <div class="footer-col">
      <h3>{t('Legal')}</h3>
      <nav style="line-height: 2;" aria-label="Legal">
        <a href="#terminos" target="_blank" rel="noopener noreferrer"
          >{t('Términos y Condiciones')}</a
        >
        <a href="#privacidad" target="_blank" rel="noopener noreferrer"
          >{t('Política de privacidad')}</a
        >
      </nav>
    </div>

    <div class="footer-col">
      <h3>{t('Ponte en contacto')}</h3>
      <address>
        <p>Dirección: Vittore Carpaccio 250, San Borja 15036</p>
        <a href="mailto:contacto@zcflow.com" target="_blank" rel="noopener noreferrer"
          >contacto@zcflow.com</a
        >
      </address>
    </div>
  </div>
</footer>

<style lang="scss">
  footer#contacto {
    color: var(--c-white);
    padding: 48px 1rem;
    font-size: 14px;
    background: var(--c-quinary);

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 2rem;
      align-items: start;
    }

    .footer-col h3 {
      color: var(--c-white);
      margin-bottom: 0.8rem;
      font-size: 1rem;
    }

    .footer-col p,
    .footer-col a,
    .footer-col address {
      color: var(--c-white);
      text-decoration: none;
    }
    .footer-col nav {
      display: flex;
      flex-direction: column;
      gap: 15px;
      width: 100%;
      max-width: 150px;
      min-width: 50px;
      a:hover {
        color: var(--c-eye);
        text-decoration: none;
      }
    }

    .footer-col address a {
      display: inline-block;
    }

    @media (max-width: 768px) {
      .footer-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
    }
  }
</style>
