---
import { localeHelper } from '../i18n/index';
import { Image } from 'astro:assets'

// const { t: _t } = Astro.props
// const t = typeof _t === 'function' ? _t : (k: unknown) => k
const base = import.meta.env.BASE_URL
const { t, path } = localeHelper(Astro);
---

<footer id="contacto" role="contentinfo" aria-label="Pie de página principal de ZCFlow">
  <div class="container" style="width: 100%; padding:0rem">
    <div class="container-footer-col">
      <div class="footer-col" itemscope itemtype="https://schema.org/Organization">
        <a href={`${base}`} aria-label="Inicio - ZCFlow">
          <Image
            src={`${base}assets/logo_header_light.webp`}
            alt="ZCFlow logo light"
            class="responsive-mode-dark"
            width={120}
            height={120}
            loading="lazy"
            decoding="async"
            itemprop="logo"
          />
        </a>
        <div class="footer-col">
          <address>
            <p style="font-size: 0.8rem; font-weight: bold; font-style: normal;margin:0px;">Perú</p>
            <p style="font-size: 0.8rem;font-style: normal;margin:0px;">
              Jr. Vittore Carpaccio 250, San Borja 15036
            </p>
          </address>
        </div>
        <meta itemprop="name" content="ZCFlow" />
        <meta itemprop="url" content="https://www.zcflow.com" />
      </div>
      <div class="slogan-text">
        <p itemprop="description" class="slogan-footer">
          {t('Predice el futuro, minimiza riesgos.')}
        </p>
      </div>
    </div>
    <div class="footer-grid" style="width: 62%;">
      <div class="footer-col">
        <h3>{t('Platform')}</h3>
        <nav aria-label="Platform" style="background:var(--c-quinary)!important;">
          <a href={`${path('')}#soluciones`} target="_blank" rel="noopener noreferrer">{t('Empresas')}</a>
          <a href={`${path('')}#soluciones`} target="_blank" rel="noopener noreferrer">{t('Socios')}</a>
          <a href={`${path('')}#soluciones`} target="_blank" rel="noopener noreferrer">{t('Soluciones')}</a>
        </nav>
      </div>
      <div class="footer-col">
        <h3>{t('Resources')}</h3>
        <nav aria-label="resources" style="background:var(--c-quinary)!important;">
          <a href={`${path('')}#zcflow`} target="_blank" rel="noopener noreferrer">{t('Quiénes somos')}</a>
          <a href={`${path('')}#fundamentos`} target="_blank" rel="noopener noreferrer">{t('Fundamentos')}</a>
          <a href={path('contacto')} target="_blank" rel="noopener noreferrer"
            >{t('Contáctanos')}</a
          >
        </nav>
      </div>
      <div style="display: flex;max-width: 50%;">
        <Image
          src={`${base}assets/win_leader.webp`}
          class="win"
          alt="win_leader"
          width={20}
          height={20}
          loading="lazy"
          decoding="async"
          itemprop="logo"
        />
        <Image
          src={`${base}assets/win_milestone.webp`}
          alt="win_mileston"
          class="win"
          width={20}
          height={20}
          loading="lazy"
          decoding="async"
          itemprop="logo"
        />
      </div>

      <div class="description-slogan" style="width: 80%;">
        <div class="footer-col">
          <nav
            style="flex-wrap: wrap; line-height: 2; background:var(--c-quinary)!important;flex-direction: row; gap:0rem;justify-content: space-between;"
            aria-label="Legal"
          >
            <a href="#terminos" target="_blank" rel="noopener noreferrer"
              >{t('Términos y Condiciones')}</a
            >
            <a href="#privacidad" target="_blank" rel="noopener noreferrer"
              >{t('Política de privacidad')}</a
            >
            <a href="#legal" target="_blank" rel="noopener noreferrer">{t('Derechos reservados')} @Zcflow</a>
          </nav>
        </div>
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
  .container-footer-col {
    width: 38%;
    display: flex;
    flex-direction: column;
    height: auto;
    row-gap: 7.5rem;
    justify-content: space-between;
  }
  .slogan-footer {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0px;
  }
  .slogan-text p {
    color: #00b0f0;
    background: linear-gradient(to right, #ffff 14%, #00b0f0 67%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .win {
    width: 39%;
  }
  .description-slogan p {
    background: linear-gradient(to right, var(--c-white) -23%, var(--c-primary-accessible) 100%);
    -webkit-background-clip: text;
    color: transparent;
    font-weight: bold;
  }
  footer#contacto {
    color: var(--c-white);
    padding: 48px 1rem;
    font-size: 14px;
    background: var(--c-quinary) !important;

    .footer-grid {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 4.5rem;
      align-items: start;
    }
    .footer-col {
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      row-gap: 1rem;

      h3 {
        color: var(--c-white);
        font-size: 1rem;
        margin: 0px;
      }

      p,
      a,
      address {
        color: var(--c-white);
        text-decoration: none;
      }

      nav {
        display: flex;
        flex-direction: column;
        gap: 15px;
        width: 100%;
        a:hover {
          color: var(--c-eye);
          text-decoration: none;
        }
      }

      address a {
        display: inline-block;
      }
    }

    @include media(mobile) {
      .footer-col nav {
        gap: 1rem;
      }
      .container {
        flex-wrap: wrap;
        height: auto;
      }
      .footer-grid {
        width: 79%;
        justify-content: flex-start;
      }
      .container-footer-col {
        width: 100%;
        gap: 0px;
      }
    }
    @include media(mobile) {
      .footer-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
    }
  }
</style>
