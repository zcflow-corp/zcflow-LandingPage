---
import { getImageMetadata } from '@/utils/imageHelper'
import { localeHelper } from '../i18n/index'
import { Image } from 'astro:assets'

const base = import.meta.env.BASE_URL
const { t, path, locale } = localeHelper(Astro)
const terminosPath = path('/terminos')
const [logoLight, win_leader, win_milestone, libro_reclamo] = await Promise.all([
  getImageMetadata('logo_movil_dark.webp'),
  getImageMetadata('win_leader.webp'),
  getImageMetadata('win_milestone.webp'),
  getImageMetadata('libro-reclamo.jpg'),
])
---

<footer id="contacto" role="contentinfo" aria-label="Pie de página principal de ZCFlow">
  <div class="container" style="width: 100%; padding:0rem">
    <div class="container-footer-col">
      <div class="footer-col" itemscope itemtype="https://schema.org/Organization">
        <a href={`${path('')}#hero`} aria-label="Inicio - ZCFlow">
          {
            logoLight && (
              <Image
                src={logoLight}
                alt="ZCFlow logo light"
                class="responsive-mode-dark"
                width={120}
                height={120}
                loading="lazy"
                decoding="async"
                itemprop="logo"
              />
            )
          }
        </a>
        <div class="footer-col">
          <address>
            <p style="font-size: 0.8rem; font-weight: bold; font-style: normal;margin:0px;">Perú</p>
            <p style="font-size: 0.8rem;font-style: normal;margin:0px;">
              Jr. Vittore Carpaccio 250, San Borja 15036
            </p>
            <p style="font-size: 0.8rem;font-style: normal;margin:0px;">
              {t('Derechos reservados')} @Zcflow
            </p>
          </address>
        </div>
        <meta itemprop="name" content="ZCFlow" />
        <meta itemprop="url" content="https://dev-companies.zcflow.com/" />
      </div>
      <div class="slogan-text">
        <p itemprop="description" class="slogan-footer">
          {t('Predice el futuro, minimiza riesgos.')}
        </p>
      </div>
    </div>
    <div class="footer-grid" style="width: 62%;">
      <div class="footer-col">
        <h3>{t('Platform')}</h3>
        <nav aria-label="Platform" style="background:var(--c-quinary)!important;">
          <a href={`${path('')}#zcflow`} rel="noopener noreferrer">{t('Empresas')}</a>
          <!-- <a href={`${path('')}#soluciones`}  rel="noopener noreferrer"
            >{t('Socios')}</a
          > -->
          <a href={'#soluciones'} rel="noopener noreferrer">{t('Soluciones')}</a>
        </nav>
      </div>
      <div class="footer-col">
        <h3>{t('Resources')}</h3>
        <nav aria-label="resources" style="background:var(--c-quinary)!important;">
          <a href={`${path('')}#zcflow`} rel="noopener noreferrer">{t('Quiénes somos')}</a>
          <a href={`${path('')}#fundamentos`} rel="noopener noreferrer">{t('Fundamentos')}</a>
          <a href={path('contacto')} rel="noopener noreferrer">{t('Contáctanos')}</a>
        </nav>
      </div>
      <div style="display: flex;max-width: 50%;">
        {
          win_leader && (
            <Image
              src={win_leader}
              class="win"
              alt="win_leader"
              width={200}
              height={200}
              loading="lazy"
              decoding="async"
              itemprop="logo"
            />
          )
        }
        {
          win_milestone && (
            <Image
              src={win_milestone}
              alt="win_mileston"
              class="win"
              width={200}
              height={200}
              loading="lazy"
              decoding="async"
              itemprop="logo"
            />
          )
        }
      </div>

      <div class="description-slogan" style="width: 80%;">
        <div class="footer-col">
          <nav
            style="flex-wrap: wrap; line-height: 2; background:var(--c-quinary)!important;flex-direction: row; gap:0.8rem;justify-content: space-between;"
            aria-label="Legal"
          >
            <a href={path('/terminos')} rel="noopener noreferrer">{t('Términos y Condiciones')}</a>

            <a href={path('/privacidad')} rel="noopener noreferrer">{t('Política de privacidad')}</a
            >

            <a href={path('reclamo')} aria-label="Libro de Reclamaciones" rel="noopener noreferrer"
              >{t('Libro de Reclamaciones')}</a
            >
          </nav>
        </div>
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
  .container-footer-col {
    width: 38%;
    display: flex;
    flex-direction: column;
    height: auto;
    row-gap: 7.5rem;
    justify-content: space-between;
  }
  .slogan-footer {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0px;
  }
  .slogan-text p {
    color: #00b0f0;
    background: linear-gradient(to right, #ffff 14%, #00b0f0 67%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .win {
    width: 39%;
  }
  .description-slogan p {
    background: linear-gradient(to right, var(--c-white) -23%, var(--c-primary-accessible) 100%);
    -webkit-background-clip: text;
    color: transparent;
    font-weight: bold;
  }
  footer#contacto {
    color: var(--c-white);
    padding: 48px 1rem;
    font-size: 14px;
    background: var(--c-quinary) !important;
    @include media(mobile) {
      .footer-col {
        width: 100%;
      }
      .footer-grid .footer-col {
        align-items: center;
      }
      .footer-col nav {
        align-items: center;
      }
      footer #contacto {
        padding: 48px 2.5rem !important;
      }
      .container {
        display: flex;
        flex-direction: column;
        gap: 0rem;
      }

      .container-footer-col {
        width: 100%;
        display: contents;

        .footer-col:first-child {
          order: 5;
          padding: 0rem 1rem;
        }
        .slogan-text {
          order: 4;
          margin: 2rem 0;
          text-align: center;
          width: 100%;
        }
      }
      .footer-grid {
        width: 100% !important;
        display: grid !important;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        order: 2;
        .footer-col:nth-child(1) {
          grid-column: 1;
          order: 1;
        }
        .footer-col:nth-child(2) {
          grid-column: 2;
          order: 2;
        }
        div[style*='display: flex'] {
          grid-column: 1 / span 2;
          order: 3;
          justify-content: center !important;
          max-width: 100% !important;
          margin-top: 1rem;
          .win {
            width: 45% !important;
          }
        }
        .description-slogan {
          grid-column: 1 / span 2;
          order: 5;
          width: 100% !important;
          nav {
            flex-direction: column !important;
            align-items: center;
            text-align: center;
          }
        }
      }
    }
    .footer-grid {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 5.5rem;
      align-items: start;
    }
    .footer-col {
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      row-gap: 1rem;

      h3 {
        color: var(--c-white);
        font-size: 1rem;
        margin: 0px;
      }

      p,
      a,
      address {
        color: var(--c-white);
        text-decoration: none;
      }

      nav {
        display: flex;
        flex-direction: column;
        gap: 15px;
        width: 100%;
        a:hover {
          color: var(--c-eye);
          text-decoration: none;
        }
      }

      address a {
        display: inline-block;
      }
    }

    @include media(mobile) {
      .footer-col nav {
        gap: 1rem;
      }
      .container {
        flex-wrap: wrap;
        height: auto;
      }
      .footer-grid {
        width: 79%;
        justify-content: flex-start;
      }
      .container-footer-col {
        width: 100%;
        gap: 0px;
      }
    }
    @include media(mobile) {
      .footer-grid {
        grid-template-columns: 1fr 1fr;
        column-gap: 0rem;
        row-gap: 1rem;
        flex-direction: column;
      }
      footer #contacto {
        padding: 48px 1.5rem important;
      }
    }
  }
</style>
