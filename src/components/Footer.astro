---
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k) => k
---

<footer id="contacto" role="contentinfo" aria-label="Pie de página principal de ZCFlow">
  <div class="container footer-grid">
    <div class="footer-col" itemscope itemtype="https://schema.org/Organization">
      <a href="/" aria-label="Inicio - ZCFlow">
        <img
          src="/public/assets/logo_header_light.webp"
          alt="ZCFlow logo light"
          width="120"
          height="auto"
          loading="lazy"
          itemprop="logo"
        />
      </a>
      <meta itemprop="name" content="ZCFlow" />
      <meta itemprop="url" content="https://www.zcflow.com" />
      <p itemprop="description">Predice el futuro, minimiza riesgos.</p>
      <small>©2025 Seidor. All rights reserved.</small>
    </div>

    <div class="footer-col">
      <h3>Platform</h3>
      <nav aria-label="Platform">
        <a href="#" target="_blank" rel="noopener noreferrer">Empresas</a>
        <a href="#" target="_blank" rel="noopener noreferrer">Soluciones</a>
        <a href="#" target="_blank" rel="noopener noreferrer">Fundamentos</a>
        <a href="#" target="_blank" rel="noopener noreferrer">Quiénes somos</a>
      </nav>
    </div>

    <div class="footer-col">
      <h3>Legales</h3>
      <nav aria-label="Legal">
        <a href="#" target="_blank" rel="noopener noreferrer">Terms of Service</a>
        <a href="#" target="_blank" rel="noopener noreferrer">Política de privacidad</a>
      </nav>
    </div>

    <div class="footer-col bg-imagen">
      <h3>Ponte en contacto</h3>
      <address>
        <p>Dirección: Calle 123, Ciudad, País</p>
        <a href="mailto:contacto@zcflow.com" target="_blank" rel="noopener noreferrer"
          >contacto@zcflow.com</a
        >
      </address>
    </div>
  </div>
</footer>

<style lang="scss">
footer#contacto {
  color: var(--c-white);
  padding: 48px 1rem;
  font-size: 14px;
  background: var(--c-black);

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
    align-items: start;
  }

  .footer-col h3 {
    color: var(--c-white);
    margin-bottom: 0.8rem;
    font-size: 1rem;
  }

  .footer-col p,
  .footer-col a,
  .footer-col address {
    color: var(--c-white);
    text-decoration: none;
  }
  .footer-col nav {
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 100%;
    max-width: 150px;
    min-width: 50px;
  }

  .footer-col address a {
    display: inline-block;
  }

  .bg-imagen {
    background-image: url('/public/assets/section_footer_contacto.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    text-align: center;
    position: relative;
    padding: 30px 16px;
    font-size: 0.8rem;
    border-radius: 8px;
    text-align: start;
    height: auto;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
}
</style>