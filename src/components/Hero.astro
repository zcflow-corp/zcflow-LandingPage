---
import Checks from './common/Check.astro'
import HeroFlow from './grafic/HeroFlow.astro'
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k) => k
const ChecksHero = ['Fácil de usar', 'Seguro', 'Inteligente']

const textos = [
  t('¿Cuál es el saldo de mi cuenta global en USD?'),
  t('¿Cuáles son los clientes que me pagan con retraso?'),
]
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-description">
      <div class="hero-description-title">
        <h1>
          <span>
            {t('Revolucionando la')}
          </span>
          <span class="gradient-blue-dark"> {t('tesorería')} </span>
        </h1>

        <h2>
          {t('Impulsado por agentes de IA')}
        </h2>
      </div>

      <p>{t('Decisiones en segundos, no en semanas.')}</p>
      <div class="cta">
        <a class="btn primary" href="#zcflow">{t('Explorar')}</a>
        <a href="/contacto" class="btn icon">{t('Pide una demo de inmediato')}</a>
      </div>

      <div class="hero-check">
        <Checks items={ChecksHero} />
      </div>
    </div>

    <div class="hero-imagen" aria-label="Mock UI">
      <HeroFlow texts={textos} t={t} />
    </div>
  </div>
</section>

<style lang="scss">

  .hero-description-title{
    width: 126%;
  }
  .hero {
    overflow: hidden;
    flex-wrap: wrap;

    section {
      padding-top: 0rem !important;
      padding-right: 0rem !important;
    }

    .container {
      padding-top: 0rem;
      padding-bottom: 0rem;

      @include media(tablet) {
        padding-bottom: 0rem;
        padding-right: 0rem !important;
      }
    }

    &-inner {
      display: flex;
      justify-content: space-between;
      flex-direction: column;
      gap: 1rem;
      grid-template-columns: 30% 60%;
      width: 100%;
      align-items: center;

      @include media(desktop) {
        flex-direction: row;
      }
    }

    &-description {
      padding-top: 2rem;
      padding-bottom: 2rem;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      align-self: center;

      flex: 0 0 40%;

      @include media(mobile) {
        width: 100%;
      }

      &-title {
        // width: 100%;
      }

      h1 {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        font-size: 2.9rem;
        gap: 0.8rem;
        width: 100%;

        @include media(mobile) {
          font-size: 2rem;
          width: 100%;
          flex-wrap: wrap;
        }

        span {
          display: flex;
          flex-direction: row;
          // flex-wrap: nowrap;
        }

        @include media(mobile) {
          display: inline-block;
        }
      }

      h2 {
        color: var(--c-primary);

        @include media(mobile) {
          font-size: 1.2rem;
          text-align: left;
          width: 100%;
        }
      }

      p {
        text-wrap: wrap;
        text-align: left;

        @include media(mobile) {
          font-size: 0.5rem;
        }
      }
    }

    &-imagen {
      display: flex;
      width: 100%;
      img {
        width: 100%;
        @include media(mobile) {
          max-width: 20rem;
          height: auto;
        }

        @include media(tablet) {
          max-width: 100%;
        }
      }

      @include media(extradesktop) {
        height: 50vh;
      }
    }

    .cta {
      display: flex;
      gap: 1rem;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 2rem;
      margin-top: 2rem;
    }

    .hero-check {
      display: flex;
      justify-content: flex-start;
      width: auto;
      align-items: flex-start;
      padding: 1rem 0rem;
      padding: 1rem 0rem;
    }
  }

  html[data-theme='dark'] .hero {
    background: var(--c-black);
  }
</style>
