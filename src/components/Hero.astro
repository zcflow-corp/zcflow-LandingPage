---
import Checks from './common/Check.astro'
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k) => k
const ChecksHero = ['Fácil de usar', 'Seguro', 'Inteligente']
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-description">
      <div class="hero-description-title">
        <h1>
          <span>
            {t('Revolucionando')}
          </span>
          {t('la')}

          <span class="gradient-blue-dark"> {t('tesorería')} </span>
        </h1>

        <h2>
          {t('Impulsado por agentes de IA')}
        </h2>
      </div>

      <p>{t('Decisiones en segundos, no en semanas.')}</p>
      <div class="cta">
        <a class="btn primary" href="#demo">{t('Explorar')}</a>
        <a class="btn ghost" href="#contacto">{t('Pide una demo de inmediato')}</a>
      </div>

      <div class="hero-check">
        <Checks items={ChecksHero} />
      </div>
    </div>

    <div class="hero-imagen" aria-label="Mock UI">
      <img
        src="/img/hero-white.gif"
        alt={t('Imagen hero')}
        class="mode-dark"
        width="100%"
        height="260"
        loading="eager"
      />

      <img
        src="/img/hero-md.gif"
        alt={t('Imagen modo dark')}
        class="mode-light"
        width="100%"
        height="260"
        loading="eager"
      />
    </div>
  </div>

  <style lang="scss">
    .hero {
      // background: var(--g-hero);
      background: #fbfcfc;
      border-bottom-left-radius: 32px;
      // border-bottom-right-radius: 32px;
      overflow: hidden;
      flex-wrap: wrap;

      section {
        padding-top: 0rem !important;
        padding-right: 0rem !important;
      }

      .container {
        padding-top: 0rem;

        @include media(tablet) {
          padding-bottom: 0rem;
          padding-right: 0rem !important;
        }
      }

      &-inner {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        flex-direction: column;
        gap: 1rem;
        width: 100%;

        flex-direction: row !important;

        @include media(tablet) {
        }
      }

      &-description {
        padding-top: 2rem;
        padding-bottom: 2rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        align-self: center;
        width: 100%;
        flex: 1;

        &-title {
          width: 100%;
        }

        h1 {
          display: flex;
          flex-direction: row;
          flex-wrap: nowrap;
          gap: 0.25rem;
          width: 100%;
          span {
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
          }
        }

        h2 {
          color: var(--c-primary);

          @include media(mobile) {
            // text-wrap: wrap;
            text-align: left;
          }
        }

        p {
          text-wrap: wrap;
          text-align: left;
        }
      }

      &-imagen {
        flex: 1;
        max-width: 100%;
        display: flex;

        img {
          width: max-content;
          @include media(mobile) {
            max-width: 20rem;
            height: auto;
          }

          @include media(tablet) {
            max-width: 100%;
          }
        }
      }

      .cta {
        display: flex;
        gap: 1rem;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 2rem;
        margin-top: 2rem;
      }

      .hero-check {
        display: flex;
        justify-content: flex-start;
        width: auto;
        align-items: flex-start;
        padding: 1rem 0rem;
        padding: 1rem 0rem;
      }
    }

    html[data-theme='dark'] .hero {
      background: var(--c-black);
    }
  </style>
</section>
