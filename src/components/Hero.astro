---
import Checks from './common/Check.astro'
import HeroFlow from './grafic/HeroFlow.astro'
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k) => k
const ChecksHero = ['Fácil de usar', 'Seguro', 'Inteligente']
const locale = Astro.currentLocale ?? 'es'
const base = import.meta.env.BASE_URL

const path = (url) => `${base}${locale}/${url}/`.replace(/\/+/g, '/')

const textos = [
  t('¿Cuál es el saldo de mi cuenta global en USD?'),
  t('¿Cuáles son los clientes que me pagan con retraso?'),
]
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-description">
      <div class="hero-description-title">
        <h1 class="hero-description-title-h1">
          <span class="gradient-blue-dark">
            {t('Revolucionando')}
            <br class="only-mobile" />
            {t('la tesorería')}
          </span>
        </h1>

        <h2>
          {t('Impulsado por agentes de IA')}
        </h2>
        <p>{t('Decisiones en segundos, no en semanas.')}</p>
      </div>
      <div class="cta">
        <a class="btn primary" href="#zcflow">{t('Explorar ahora')} </a>
        <a href={path('contacto')} class="btn icon">{t('Pide una demo de inmediato')}</a>
      </div>

      <!-- <div class="hero-check">
        <Checks items={ChecksHero} />
      </div> -->
    </div>

    <div class="hero-imagen" aria-label="Mock UI">
      <HeroFlow texts={textos} t={t} />
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    overflow: hidden;
    flex-wrap: wrap;
    position: relative;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -100;
      // background-image: url('/assets/hero.gif');
      background-repeat: no-repeat;
      background-size: contain;
      animation: changeBgHero 12s forwards;
      transform: rotate(-70deg);
      background-position: 159%;
      bottom: -39%;
      right: 0%;

      @include media(tablet-down) {
        .hero-description {
          align-self: center;
        }
        // transform: rotate(-78deg);
        // background-position: 186%;
        // bottom: -5%;
        // right: -55%;
        // background-size: 117%;
        transform: rotate(-10deg);
        background-position: 52%;
        bottom: -56%;
        right: -270%;
        background-size: 165%;
      }

      @include media(desktop) {
        transform: rotate(-50deg);
        background-position: 145% 30% center right;
        bottom: -5%;
        right: -25%;
      }

      @include media(extradesktop) {
        // background-position: 145% 30% center;
        // background-position: 100%;
        // bottom: -19%;
        // right: -14%;
        inset: 0 0% 0 0;
        position: absolute;
        transform: rotate(-60deg);
        transform: rotate(-65deg);
      }
    }
    .only-mobile {
      display: none;

      @include media(mobile) {
        display: inline;
      }
    }
    .container {
      padding-top: 0rem;
      padding-bottom: 0rem;

      // @include media(tablet) {
      //   padding-bottom: 0rem;
      //   padding-right: 0rem !important;
      // }
    }

    &-inner {
      display: flex;

      flex-direction: column;
      justify-content: flex-start;
      gap: 1rem;
      // grid-template-columns: 30% 60%;
      width: 100%;

      @include media(desktop) {
        flex-direction: row;
        justify-content: space-between;
      }
    }

    &-description {
      padding-bottom: 2rem;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      align-self: center;
      row-gap: 2rem;

      @include media(mobile) {
        width: 100%;
      }

      @include media(tablet) {
        margin-top: 2rem;
      }

      @include media(desktop) {
        width: 45%;
        margin-top: -2rem;
      }

      &-title {
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        width: 120%;

        @include media(mobile) {
          width: 100%;
        }
      }

      h1 {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        font-size: 2.8rem;
        gap: 0.8rem;
        width: 100%;
        white-space: normal;
        animation: gradient-move 15s ease infinite;

        @include media(mobile) {
          font-size: 2rem;
          width: 100%;
          flex-wrap: wrap;
        }

        @include media(desktop) {
          width: 180%;
          flex-wrap: nowrap;
          font-size: 3.2rem;
        }
      }

      h2 {
        color: var(--c-primary);
        font-size: 1.75rem;
        @include media(mobile) {
          font-size: 1rem;
          width: 100%;
          text-align: center;
        }
      }

      p {
        text-align: left;
        text-wrap: nowrap !important;
        @include media(mobile) {
          font-size: 0.9rem;
          font-weight: 800;
          text-wrap: wrap !important;
          width: 100%;
          text-align: center;
        }
      }
    }

    &-imagen {
      display: flex;
      width: 100%;
      min-height: 50vh;

      @include media(tablet) {
        min-height: 90vh;
      }

      @include media(extradesktop) {
        min-height: 50vh;
      }
      img {
        width: 100%;
        max-width: 20rem;
        // min-height: 80vh;
        @include media(tablet) {
          max-width: 100%;
        }
      }
    }

    .cta {
      display: flex;
      gap: 1rem;
      // margin-top: 2rem;
      flex-wrap: wrap;
      align-items: flex-start;

      .icon {
        padding-left: 0rem;
      }
      @include media(mobile) {
        justify-content: center;
      }
      @include media(tablet) {
        flex-wrap: nowrap;
      }

      @include media(desktop) {
        flex-wrap: nowrap;
      }
    }

    .hero-check {
      display: flex;
      justify-content: flex-start;
      width: auto;
      align-items: flex-start;
      padding: 1rem 0rem;
    }

    @include media(desktop) {
      height: 90vh;
    }

    .hero-description-title-h1 {
      white-space: nowrap;
      line-height: 1.2;
      @include media(mobile-small) {
        justify-content: center;
        white-space: normal;
        font-size: 2rem;
        line-height: 1.1;
      }
    }
    .gradient-blue-dark {
      @include media(mobile-small) {
        text-align: center !important;
      }
    }

    @include media(mobile-small) {
      .only-mobile {
        display: block;
      }
    }
  }

  @keyframes changeBgHero {
    /* 1️⃣ Primera imagen → 3s */
    0%,
    25% {
      background-image: url('/assets/hero3.webp');
    }

    /* 2️⃣ Segunda imagen → 4s */
    26%,
    50% {
      background-image: url('/assets/hero2.gif');
    }

    /* 3️⃣ Tercera imagen → 5s (se queda) */
    51%,
    100% {
      background-image: url('/assets/hero3.webp');
    }
  }

  html[data-theme='dark'] .hero {
    background: transparent;
    position: relative;
    &::before {
      background-image: url('/assets/herob.webp');
      animation: none;

      position: absolute;
      transform: rotate(59deg);
      background-position: top center;
      bottom: -10%;
      left: 30%;
      transform: rotate(-60deg);
      opacity: 0.4;

      @include media(mobile) {
        // left: 2%;
        // transform: rotate(-90deg);
        background-position: top center;
        bottom: -22%;
        left: -315%;
        transform: rotate(-55deg);
        background-size: contain;
      }
    }
  }
</style>
