---
import Tabs from './common/Tabs.astro'
import { soluciones } from '@/data/soluciones'
import { getImageMetadata } from '@/utils/imageHelper'
import { promise } from 'astro:schema'
import { SubTitle } from 'chart.js'
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k) => k
const rawData = soluciones(t)
const baseData = rawData[0]

const itemsWithImages = {
  ...baseData,
  pestana: await Promise.all(
    baseData.pestañas.map(async (p) => {
      const optimizedSlides = await Promise.all(
        p.slides.map(async (slides) => {
          const imagePath = slides.image?.src
          const metadata = await getImageMetadata(imagePath)
          return {
            ...slides,
            image: imagePath,
            imageMetadata: metadata || {},
          }
        })
      )

      return {
        ...p,
        slides: optimizedSlides,
      }
    })
  ),
}
---

<section id="soluciones" class="section">
  <div class="container title hero-solutions">
    <div class="section-title">
      <span class="gradient-blue-dark"> {t('Soluciones')} </span>
      <h2>
        {t('Lo que')}
        <span>
          {t('podrás hacer')}
        </span>
        {t('con Zcflow')}
      </h2>
      <p>
        {t('Zcflow ofrece diversas funcionalidades para el tesorero moderno')}
      </p>
    </div>

    <Tabs TabsJson={itemsWithImages} client:load />
  </div>
</section>

<style lang="scss">
  .hero-solutions {
    flex-direction: column;

    @include media(tablet) {
      flex-wrap: wrap;
    }
  }
</style>
