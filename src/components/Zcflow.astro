---
import CardSlider from 'src/islands/CardSlider.jsx'
import TrustedBy from './TrustedBy.astro'
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k) => k

const slides = [
  {
    title: t('Integración total'),
    description: t(
      'ZCFlow conecta tu ecosistema financiero y ERPs en una plataforma 100% data driven'
    ),
    image: '/public/assets/section_zcflow_1.svg',
    alt: 'Paneles de ZCflow con gráficos',
    Icono: 'conexion',
    hasFlow: true,
    id: 1,
  },

  {
    title: t('Decisiones precisas'),
    description: t('De hojas de cálculo a decisiones confiables y asistidas desde un solo lugar'),
    image: '/public/assets/section_zcflow_3.svg',
    alt: 'Proyecciones con IA',
    Icono: 'reporte',
    hasFlow: true,
    id: 2,
  },
  {
    title: t('IA predictiva'),
    description: t('Agentes de IA que anticipan escenarios, reducen riesgos y optimizan costos'),
    image: '/public/assets/section_zcflow_2.svg',
    alt: 'Conectores y tablero',
    Icono: 'automatizaciones',
    hasFlow: true,
    id: 3,
  },
]
---

<section class="section zcflow-who">
  <div class="container">
    <div class="zcflow-description">
      <div>
        <CardSlider
          slides={slides}
          interval={10000}
          startIndex={0}
          title={t('ZCflow, tu IA para predecir tus finanzas')}
          description={t(
            'Plataforma financiera con IA que integra, reduce riesgos y transforma finanzas con decisiones precisas'
          )}
          word="Zcflow"
          client:load
        />
      </div>

      <TrustedBy />
    </div>
  </div>
</section>

<style lang="scss">
  .zcflow-who {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    background: var(--c-bg-variant);
    padding-top: 2rem;
  }

  html[data-theme='dark'] .zcflow-who {
    background-color: transparent;
  }
</style>
