---
import CardZcflow from '@/islands/CardZcflow'
import { getSlides } from '@/data/slides'
import { getImageMetadata } from '@/utils/imageHelper'

const { t: _t, locale } = Astro.props
const t = typeof _t === 'function' ? _t : (k) => k
const slides = getSlides(t)
const logo_movil_dark = await getImageMetadata('logo_movil_dark.webp')
const itemsWithImages = await Promise.all(
  slides.map(async (p) => {
    const imagePath = p.image?.src
    const metadata = await getImageMetadata(imagePath)
    return {
      ...p,
      image: imagePath,
      imageMetadata: metadata || {},
    }
  })
)
---

<section id="zcflow" class="section zcflow-who">
  <div class="container">
    <div class="zcflow-description">
      <div class="section-title-center">
        <span class="gradient-blue-dark">
          {t('Conoce Zcflow')}
        </span>
        <h2 class="">
          {t('Así resolvemos lo que nadie resuelve')}
        </h2>
      </div>
      <div>
        <div>
          <CardZcflow
            slides={itemsWithImages}
            logo_movil_dark={logo_movil_dark}
            interval={10000}
            startIndex={0}
            title={t('Asi resolvemos lo que nadie resuelve')}
            client:load
          />
        </div>
      </div>
    </div>
  </div>

  <style lang="scss">
    .zcflow-who {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      background: var(--c-black);

      h2 {
        color: var(--c-white);
      }
    }

    .zcflow-description {
      width: 100%;
    }

    html[data-theme='dark'] .zcflow-who {
      background-color: transparent;
    }
  </style>
</section>
