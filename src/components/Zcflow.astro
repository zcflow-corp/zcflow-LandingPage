---
import CardSlider from 'src/islands/CardSlider.jsx'
import CardZcflow from '@/islands/CardZcflow'

const { t: _t, locale } = Astro.props
const t = typeof _t === 'function' ? _t : (k) => k
const base = import.meta.env.BASE_URL

const slides = [
  {
    title: t('IA predictiva'),
    description: t('Agentes de IA que anticipan escenarios, reducen riesgos y optimizan costos'),
    image: `${base}assets/section_zcflow_2.svg`,
    alt: 'Conectores y tablero',
    Icono: 'automatizaciones',
    hasFlow: true,
    id: 1,
  },
  {
    title: t('Integración total'),
    description: t(
      'ZCFlow conecta tu ecosistema financiero y ERPs en una plataforma 100% data driven'
    ),
    image: `${base}assets/section_zcflow_1.svg`,
    alt: 'Paneles de ZCflow con gráficos',
    Icono: 'conexion',
    hasFlow: true,
    id: 2,
  },

  {
    title: t('Decisiones precisas'),
    description: t('De hojas de cálculo a decisiones confiables y asistidas desde un solo lugar'),
    image: `${base}assets/section_zcflow_3.svg`,
    alt: 'Proyecciones con IA',
    Icono: 'reporte',
    hasFlow: true,
    id: 3,
  },
]
---

<section id="zcflow" class="section zcflow-who">
  <div class="container">
    <div class="zcflow-description">
      <span class="gradient-blue-ligth">
        {t('Zcflow')}
      </span>
      <h2 class="">
        {t('Asi resolvemos lo que nadie resuelve')}
      </h2>
      <div>
        <CardZcflow
          slides={slides}
          interval={10000}
          startIndex={0}
          title={t('Asi resolvemos lo que nadie resuelve')}
          t={t}
          locale={locale}
          client:load
        />
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .zcflow-who {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--c-black);

    h2 {
      margin-bottom: 2rem;
      color: var(--c-white);
    }
  }

  .zcflow-description {
    display: flex;
    flex-direction: column;
    // gap: 1rem;
    align-items: center;
  }

  html[data-theme='dark'] .zcflow-who {
    background-color: transparent;
  }
</style>
