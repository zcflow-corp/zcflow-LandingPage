---
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k: unknown) => k
const base = import.meta.env.BASE_URL
const locale = Astro.currentLocale ?? 'es'

const path = (url) => `${base}${locale}/${url}/`.replace(/\/+/g, '/')
---

<section id="about" class="section about-banner" aria-labelledby="about-title">
  <div class="container">
    <div class="about-text">
      <h2 id="about-title" class="about-title-contacto">{t('El flujo de caja es el rey')}</h2>
      <a
        href={path('contacto')}
        class="btn emptyghost"
        aria-label={t('Ir a la sección de contacto')}
      >
        {t('Solicita una demo')}
      </a>
    </div>
  </div>
</section>
<style lang="scss">

  .about-title-contacto {
    margin: 0%;
    font-size: 4rem;
    letter-spacing: 0.4px;
    font-weight: 500;
    line-height: 106%;
    text-align: start;
  }
  .about-banner {
    background-image: url('/assets/Banner.webp');
    padding-bottom: 0rem;
    width: 100%;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    height: 100vh;
  }

  .btn.emptyghost {
    background: transparent;
    border: 2px solid var(--c-white);
    border-radius: 10px;
    color: var(--c-white);
    width: 100%;
    max-width: 150px;
    min-width: 125px;
    height: 45px;
    padding: 0px 20px;
  }
  .about-banner .container {
    position: relative;
    padding-bottom: 0px;
    align-items: flex-end;
    justify-content: center;
    height: 58%;
    // max-height: 651px;
    width: 100%;
    gap: 0rem;
    z-index: 1;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1 1 400px;
    gap: 19px;
    // padding-bottom: 7rem;
    justify-content: center;
    align-items: center;
  }
  .about-text h2,
  .about-text a {
    color: var(--c-white);
    margin: 0;
  }
  /**
* alojar css en un archivo a parte css
 */
  .about-text a {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 200px;
    padding: 24px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 1rem;
    text-decoration: none;

    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

    color: var(--c-white);
    border: 1.5px solid transparent;

    background-clip: padding-box;
    overflow: hidden;
  }

  .about-text a::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: var(--g-primary-light);
    background-size: 300% 100%;
    animation: infinityBorder 4s linear infinite;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  @keyframes infinityText {
    0%,
    100% {
      color: var(--c-white);
      text-shadow: 0 0 4px rgba(0, 184, 217, 0.3);
    }
    50% {
      color: var(--c-primary);
      text-shadow:
        0 0 10px rgba(5, 99, 255, 0.8),
        0 0 20px rgba(0, 184, 217, 0.6);
    }
  }
  @keyframes infinityBorder {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 300% 50%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-text a,
    .about-text a::before {
      animation: none;
    }
  }
  .about-text a:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 4px;
  }

  .about-text h2 {
    background: linear-gradient(to right, var(--c-white) 59%, var(--c-primary-accessible) 100%);
    -webkit-background-clip: text;
    color: transparent;
  }

    @include media(tablet-down) {
    
    .about-banner .container {
      flex-direction: column;
      align-items: center;
      padding-bottom: 0px;
      height: auto;
    }
    .about-title-contacto {
      font-size: 1.9rem;
    }
    .about-text {
      flex: auto;
      max-width: 100%;
      padding-bottom: 2rem;
    }
    .about-banner {
      height: 400px;
      background-position: center 30%;
    }
  }

  @include media(desktop) {
    .about-banner {
      height: 404px;
    }

  }

  @include media(extradesktop) {
    .about-banner {
      height: 600px;
    }

  }

</style>
