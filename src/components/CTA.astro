---
import { Image } from 'astro:assets'

const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k: unknown) => k
const base = import.meta.env.BASE_URL
---

<section id="about" class="section about-banner" aria-labelledby="about-title">
  <div class="container">
    <div class="about-text">
      <h2 id="about-title" class="about-title-contacto">{t('El flujo de caja es el rey')}</h2>
      <a
        href="#contacto"
        class="btn emptyghost"
        style="border: 2px solid #ffff;min-width: 186px;height:48px; background:var(--c-primary-accessible); border-radius:100px;"
        aria-label={t('Ir a la sección de contacto')}
      >
        {t('Solicita una demo')}
      </a>
    </div>
  </div>
</section>
<style lang="scss">
  .about-title-contacto {
    margin: 0%;
    font-size: 5rem;
    letter-spacing: 0.4px;
    font-weight: 500;
    line-height: 106%;
    text-align: start;
  }
  .about-banner {
    background-image: url('/assets/Banner.webp');
    padding-bottom: 0rem;
    width: 100%;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    height: 100vh;
    max-height: 979px;
  }

  @include media(mobile) {
    .about-banner {
      height: 50vh;
      max-height: 400px;
      background-position: center 30%;
    }
  }

  .btn.emptyghost {
    background: transparent;
    border: 2px solid var(--c-white);
    border-radius: 10px;
    color: var(--c-white);
    width: 100%;
    max-width: 150px;
    min-width: 125px;
    height: 45px;
    padding: 0px 20px;
  }
  .about-banner .container {
    position: relative;
    padding-bottom: 0px;
    align-items: flex-end;
    justify-content: center;
    height: 58%;
    // max-height: 651px;
    width: 100%;
    gap: 0rem;
    z-index: 1;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1 1 400px;
    gap: 34px;
    // padding-bottom: 7rem;
    justify-content: center;
    align-items: center;
  }
  .about-text h2,
  .about-text a {
    color: var(--c-white);
    margin: 0;
  }
  .about-text h2 {
    background: linear-gradient(to right, var(--c-white) 59%, var(--c-primary-accessible) 100%);
    -webkit-background-clip: text;
    color: transparent;
  }
  @include media(mobile) {
    .about-banner .container {
      flex-direction: column;
      align-items: center;
      padding-bottom: 0px;
      height: 317px;
    }
    .about-title-contacto {
      font-size: 1.9rem;
    }
    .about-text {
      flex: auto;
      max-width: 100%;
      padding-bottom: 2rem;
    }
  }
</style>
