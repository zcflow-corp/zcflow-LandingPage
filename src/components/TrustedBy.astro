---
import LogosTicker from './LogosTicker.astro'
const { t: _t, texts = [] } = Astro.props
const t = typeof _t === 'function' ? _t : (k: string) => k
---

<section class="">
  <div class="trustedby">
    <h4>{t('Nuestros Partners que confian en nosotros')}</h4>

    <div class="logo-row" style="margin-top:1rem">
      <LogosTicker
        items={[
          { name: 'logoaws', title: 'Amazon Web Services' },
          { name: 'logouipath', title: 'UiPath' },
          { name: 'logorems', title: 'Rems' },
          { name: 'logopen', title: 'OpenAI' },
        ]}
        cols={4}
        interval={1800}
      />
    </div>
  </div>
</section>

<style lang="scss">
  .trustedby {
    display: flex;
    width: 100%;
    justify-content: center;
    flex-direction: column;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 1rem;
  }

  html[data-theme='dark'] .trustedby {
    background: transparent;
  }
</style>
