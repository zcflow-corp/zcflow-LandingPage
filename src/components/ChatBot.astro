---
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k: unknown) => k
---

<section id="chatBot" aria-labelledby="chatbot-title">
  <div class="container">
    <div>
      <span>Ask BOTO</span>
      <h3>Converse con la tesorería del futuro.</h3>
      <p>
        {
          t(
            ' Inicia una conversación con BOTO, tu nuevo asesor financiero digital. Disponible 24/7. Descubre ideas, recomendaciones y análisis en segundos. Hazle preguntas sobre liquidez,proyecciones, riesgos o estrategias financieras, y obtén respuestas claras y accionables.'
          )
        }
      </p>
    </div>
  </div>
  <div>
    <iframe
      width="100%"
      height="450"
      src="https://www.canva.com/design/DAG7T8eAAqU/MXAc_bYcL9L3pMIyMve3hg/watch?utm_content=DAG7T8eAAqU&utm_campaign=designshare&utm_medium=link2&utm_source=uniquelinks&utlId=h5c39d1dcbb"
      title="Video de demostración del Asesor Financiero BOTO"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="lazy"
    >
      Tu navegador no soporta iframes. Por favor, visita el video directamente en [Enlace a tu
      video].
    </iframe>
  </div>
</section>
<style lang="scss">
  section {
    background: var(--c-primary-accessible);
  }
</style>
