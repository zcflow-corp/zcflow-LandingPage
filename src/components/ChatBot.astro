---
import { localeHelper } from '../i18n/index'
import videoChatBoto from '@/assets/BOTO_Chatbot_Web.mp4'
// const { t: _t } = Astro.props
// const t = typeof _t === 'function' ? _t : (k: unknown) => k
const base = import.meta.env.BASE_URL
const { locale, t } = localeHelper(Astro)
---

<section class="chatBot" id="chatBot" aria-labelledby="chatbot-title">
  <div class="container" style="width: 100%;padding:3.5rem">
    <div class="container-section-description">
      <div class="container-beta">
        <span class="beta"> BETA </span>
      </div>
      <h1 class="container-section-description-title">Ask BOTO</h1>
      <h2 class="container-section-description-slogan">
        {t('Converse con la tesorería del futuro.')}
      </h2>
      <p class="container-section-description-BOTO">
        {
          t(
            'Inicia una conversación con BOTO, tu nuevo asesor financiero digital. Disponible 24/7.'
          )
        }
      </p>
      <p class="container-section-description-BOTO">
        {t('Descubre ideas, recomendaciones y análisis en segundos.')}
        <br />

        {
          t(
            'Hazle preguntas sobre liquidez, proyecciones, riesgos o estrategias financieras, y obtén respuestas claras y accionables.'
          )
        }
      </p>
    </div>
    <div class="container-section-iframe">
      <video
        width="100%"
        height="450"
        title="Video de demostración del Asesor Financiero BOTO"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        controls
        class="boto-video"
      >
        <source
          src={typeof videoChatBoto === 'string' ? videoChatBoto : videoChatBoto}
          type="video/mp4"
        />
      </video>
    </div>
  </div>
</section>
<style lang="scss">
  .chatBot {
    background: #0858fd;
    padding: 0rem;
    @include media(mobile) {
      height: 72vh !important;
    }

    .container {
      width: 100%;
      height: auto;
      background: #0858fd;

      @include media(mobile) {
        height: auto !important;
      }

      @include media(tablet) {
        max-height: 500px;
      }
    }
  }
  .container-section-video {
    width: 100%;
    max-width: 49%;
    height: 450px;
  }

  .boto-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .container-section-description {
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    max-width: 51%;
    row-gap: 0.3rem;
    .beta {
      background-color: transparent;
      color: var(--c-white);

      border: 1px solid var(--c-white);
    }
  }
  .container-section-description-title {
    font-size: 3rem;
    font-weight: lighter;
    color: var(--c-white);
    margin: 0px;
  }
  .container-section-description-keyword {
    color: var(--c-black);
    margin: 11px 0px;
    background: var(--c-bg-variant);
    max-width: 10%;
    padding: 0.4rem;
    border-radius: 3px;
    font-size: 0.7rem;
    text-align: center;
    letter-spacing: 2px;
  }
  .container-section-description-BOTO {
    color: var(--c-white);
    font-size: 1rem;
    font-weight: normal;
    margin: 0px;
    line-height: 1.3;
  }
  .container-section-description-slogan {
    color: #00b0f0;
    background: linear-gradient(to right, #ffff 14%, #00b0f0 67%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    margin: 10px 0px;
    font-size: 1.3rem;
    font-weight: bold;
  }
  section {
    // background: #006ffd;
    background: #0858fd;
    padding: 3rem;
  }

  .container-section-iframe {
    width: 100%;
    max-width: 49%;
  }
  @include media(tablet-down) {
    .container-section-description-keyword {
      max-width: 15%;
    }
  }

  @include media(mobile) {
    #chatBot .container {
      width: 100%;
      height: 100vh;

      @include media(tablet) {
        max-height: 500px;
      }
    }
    .container-card {
      display: flex;
      flex-wrap: wrap;
      row-gap: 1rem;
    }
    section .container {
      flex-wrap: wrap;
    }
    .container-section-description {
      max-width: 100%;
    }
    .container-section-iframe {
      max-width: 100%;
    }
    .container-section-description-keyword {
      max-width: 22%;
    }
  }
</style>
