---
import IconoSvg from '../IconoSvg.astro'

// CardSlider.astro
/** @typedef {{ title: string; description: string; image: string; alt?: string }} Slide */

/**
 * Props del componente CardSlider
 * - t?: (k: string) => string
 * - slides: Slide[]
 * - interval?: number (ms)
 * - startIndex?: number
 * - title?: string
 * - description?: string
 * - word?: string
 */
const {
  t: _t,
  slides = [],
  interval = 5000,
  startIndex = 0,
  title = '',
  description = '',
  word = '',
} = Astro.props

const t = typeof _t === 'function' ? _t : (k: string) => k
---

<section class="card-slider" aria-label="Card Slider">
  <div
    class="card-slider__viewport js-card-slider"
    data-interval={String(interval)}
    data-count={String(slides.length)}
    data-start-index={String(startIndex)}
    aria-roledescription="carrusel"
    aria-live="polite"
  >
    <!-- Media (apiladas en el mismo marco) -->
    <div class="card-slider__media card-slider__container">
      {
        slides.map((s, i) => (
          <figure
            class={`card-slider__figure${i === startIndex ? ' card-slider__figure--active' : ''}`}
            data-index={String(i)}
            aria-hidden={i === startIndex ? 'false' : 'true'}
          >
            <div class="card-slider__bg" />
            <div class="card-slider__img-wrap">
              <img
                class="card-slider__img"
                loading={i === startIndex ? 'eager' : 'lazy'}
                src={s.image}
                alt={s.alt ?? s.title}
              />
            </div>
          </figure>
        ))
      }
    </div>

    <!-- Contenido: TODAS las descripciones visibles; se resalta la activa -->
    <div class="card-slider__content card-slider__container">
      <div class="card-slider__title">
        <span>{word}</span>
        <h2 class="gradient-blue-dark" ">{title}</h2>
        <p>{description}</p>
      </div>

      <ul class="card-slider__desc-list" role="tablist" aria-label="Listado de descripciones">
        {
          slides.map((s, i) => (
            <li
              class={`card-slider__desc-item${i === startIndex ? ' card-slider__desc-item--active' : ''}`}
              data-index={String(i)}
              role="tab"
              aria-selected={i === startIndex ? 'true' : 'false'}
              tabindex="0"
            >
              <IconoSvg name={t(s.Icono)} class="icon" ariaLabel="Activo" />

              <div class="content-slider">
                <article class="card-slider__desc">
                  <span class="card-slider__desc-title">{t(s.title)}</span>, {t(s.description)}
                </article>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script is:inline>
  // Autoplay + sincronización imagen/descripcion (una activa; todas visibles)
  ;(() => {
    const root = document.querySelector('.js-card-slider')
    if (!root) return

    const figures = Array.from(root.querySelectorAll('.card-slider__figure'))
    const items = Array.from(root.querySelectorAll('.card-slider__desc-item'))
    const dots = Array.from(root.querySelectorAll('.card-slider__dot'))
    const prevBtn = root.querySelector('[data-action="prev"]')
    const nextBtn = root.querySelector('[data-action="next"]')

    const interval = Number(root.getAttribute('data-interval')) || 5000
    let index = Number(root.getAttribute('data-start-index')) || 0
    let timer

    const setActive = (i) => {
      const total = figures.length
      index = (i + total) % total

      figures.forEach((el, k) => {
        const on = k === index
        el.classList.toggle('card-slider__figure--active', on)
        el.setAttribute('aria-hidden', on ? 'false' : 'true')
        if (on) {
          // Reinicia la animación de la imagen activa
          void el.offsetWidth
          el.classList.remove('card-slider__figure--stagger')
          setTimeout(() => el.classList.add('card-slider__figure--stagger'), 10)
        }
      })

      items.forEach((it, k) => {
        const on = k === index
        it.classList.toggle('card-slider__desc-item--active', on)
        it.setAttribute('aria-selected', on ? 'true' : 'false')
      })

      dots.forEach((d, k) => d.classList.toggle('card-slider__dot--active', k === index))
    }

    const next = () => setActive(index + 1)
    const prev = () => setActive(index - 1)
    const play = () => {
      stop()
      timer = setInterval(next, interval)
    }
    const stop = () => {
      if (timer) clearInterval(timer)
    }

    dots.forEach((d) =>
      d.addEventListener('click', (e) => {
        setActive(Number(e.currentTarget.getAttribute('data-index')))
        play()
      })
    )
    prevBtn?.addEventListener('click', () => {
      prev()
      play()
    })
    nextBtn?.addEventListener('click', () => {
      next()
      play()
    })

    // Click/Enter sobre la descripción para activar su imagen
    items.forEach((it) => {
      it.addEventListener('click', () => {
        setActive(Number(it.getAttribute('data-index')))
        play()
      })
      it.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault()
          setActive(Number(it.getAttribute('data-index')))
          play()
        }
      })
    })

    root.addEventListener('mouseenter', stop)
    root.addEventListener('mouseleave', play)
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        next()
        play()
      }
      if (e.key === 'ArrowLeft') {
        prev()
        play()
      }
    })

    setActive(index)
    play()
  })()
</script>

<style lang="scss">
  .card-slider {
    font-family: var(--font-body);
    color: var(--c-text);
    width: 100%;

    &__title {
      padding-bottom: 1rem;
    }

    &__container {
      width: min(var(--container), 62vw);
      margin-inline: auto;
    }

    &__viewport {
      position: relative;
      display: grid;
      gap: 2rem;
    }

    /* === Media: MISMO MARCO para todas las slides === */
    &__media {
      position: relative;
      display: block;
      background: var(--g-primary);
      border-radius: var(--radius);
      overflow: hidden;
      min-height: 20rem;
      width: 100%;
      padding: 1rem;
    }

    &__figure {
      position: absolute;
      inset: 0;
      margin: 0;
      display: grid;
      place-items: center;
      opacity: 0;
      transform: scale(0.995);
      pointer-events: none;
      transition:
        opacity 0.6s ease,
        transform 0.6s ease;
    }

    &__figure--active {
      opacity: 1;
      transform: scale(1);
      pointer-events: auto;
      z-index: 1;
    }

    &__bg {
      position: absolute;
      inset: -3%;
      background: var(--g-primary-dark);
      border-radius: var(--radius);
      filter: blur(40px);
      opacity: 0.35;
      pointer-events: none;
    }

    &__img-wrap {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
      padding: 0; /* marco limpio y consistente */
    }

    &__img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain; /* usa 'contain' si no quieres recorte */
      object-position: left bottom;
      opacity: 0;
      transition: opacity 0.7s ease;
      padding: 1rem 1rem 0rem 1rem;
    }

    /* cuando la figura activa agrega stagger */
    &__figure--stagger &__img {
      opacity: 1;
    }

    /* === Content (todas visibles) === */
    &__content {
      display: grid;
      gap: 1rem;
      width: 100%;
    }

    &__title {
      font-family: var(--font-head);
      line-height: 1.2;
      margin: 0 0 0.25rem 0;
    }

    &__desc-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.5rem;
    }

    &__desc-item {
      // border: 1px solid var(--c-line-acc);
      border-radius: var(--radius);
      padding: 0.9rem 1rem;
      cursor: pointer;
      transition:
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;
      outline: none;
      display: flex;
      flex-direction: row;
      gap: 0.5rem;
      align-items: flex-start;

      .content-slider {
        display: inline-block;
        align-self: flex-start;
        text-wrap: wrap;
        line-height: 24px;

        padding-top: 0rem;
      }

      .card-slider__desc-title {
        color: var(--c-line);
        opacity: 0.5;
        font-weight: 300;
        font: medium;
      }
      .card-slider__desc {
        color: var(--c-line);
        opacity: 0.3;
        font-weight: 300;
        font-size: medium;
      }

      &:hover {
        // border-color: var(--c-primary-accessible);
      }
      &:focus-visible {
        // box-shadow: 0 0 0 2px var(--c-text);
        color: var(--c-text);
      }
    }

    &__desc-item--active {
      // border-color: var(--c-primary-accessible);

      // background:
      //   linear-gradient(0deg, rgba(5, 99, 255, 0.06), rgba(5, 99, 255, 0.06)), var(--c-panel);

      box-shadow: var(--shadow);
      background-color: var(--c-white);
      opacity: 1;

      .card-slider__desc-title {
        background: var(--c-black);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        font-size: large;
        opacity: 1;
        font-weight: 800;
      }
      .card-slider__desc {
        color: var(--c-text);
        font-size: medium;
        opacity: 1;
      }
    }

    &__dots {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
    }

    &__dot {
      inline-size: 30px;
      block-size: 6px;
      border-radius: var(--radius);
      background: var(--d7);
      border: 0;
      cursor: pointer;
      transition:
        inline-size 0.25s ease,
        background 0.25s ease;

      &--active {
        inline-size: 46px;
        background: var(--d4);
      }
    }

    /* Layout responsive */
    @include media(desktop) {
      &__viewport {
        grid-template-columns: 1fr 1fr;
        align-items: start;
      }
      &__media {
        min-height: 30rem; /* si usas aspect-ratio arriba, puedes quitar esto */
      }
    }

    .icon__inner svg {
      width: 10px;
      height: 10px;
      background: aqua !important;
    }

    @media (prefers-reduced-motion: reduce) {
      &__figure,
      &__img {
        transition: none !important;
      }
    }
  }

  html[data-theme='dark'] .card-slider {
    .card-slider__desc-title {
      background-image: var(--g-primary-light);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }

    .card-slider__desc {
      color: var(--d6);
    }

    &__desc-item--active {
      background: var(--c-gray);
    }
  }
</style>
