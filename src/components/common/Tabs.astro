---
// Recibe los datos como prop
import CardSolution from 'src/islands/CardSolution.jsx'

const { TabsJson } = Astro.props
let active = 0
---

<div class="tabs-container" id="tabs-root">
  <div class="tabs-solutions">
    <div class="tabs-process">
      <span class="process" id="out"> </span>
    </div>
    <!-- Botones -->
    <div role="tablist" aria-label="Qué podrás hacer" class="tabs tablist">
      {
        TabsJson.pestañas.map((t, i) => (
          <button
            role="tab"
            id={`tab-${i}`}
            class={`tab-btn ${i === active ? 'active' : ''}`}
            aria-selected={i === active}
            data-process={Number(t.process)}
            aria-controls={`panel-${i}`}
            tabindex={i === active ? '0' : '-1'}
          >
            <p class="tab-title"> {t.título} </p>

            <span>{t.titleSub}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Paneles -->
  <div class="tab-panels">
    {
      TabsJson.pestañas.map((t, i) => (
        <div
          id={`panel-${i}`}
          role="tabpanel"
          hidden={i !== active}
          aria-labelledby={`tab-${i}`}
          class="tab-panel"
          style={`display: ${i === active ? 'block' : 'none'}`}
        >
          <div class="slider-functions">
            {Array.isArray(t.slides) && t.slides.length > 0 && (
              <CardSolution
                slides={t.slides}
                interval={6000}
                startIndex={0}
                title={t.SubTitle}
                description={t.resumen}
                word={t.título}
                client:load
                textinfo={t.textinfo}
              />
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  const container = document.getElementById('tabs-root')!
  const tabs = container.querySelectorAll<HTMLButtonElement>('.tab-btn')
  const panels = container.querySelectorAll<HTMLElement>('.tab-panel')
  tabs[0].classList.add('activeTab')

  const out = document.querySelector('#out')
  function setWidth(percent) {
    out.style.width = `${percent}%` // 👈 cambia el atributo CSS
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', (e) => {
      const percent = Number(e.currentTarget.dataset.process)
      setWidth(percent)
    })

    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('activeTab')
        t.setAttribute('aria-selected', 'false')
        t.tabIndex = -1
      })
      panels.forEach((p) => (p.style.display = 'none'))
      tab.classList.add('activeTab')
      tab.setAttribute('aria-selected', 'true')
      tab.tabIndex = 0
      panels[i].style.display = 'block'
    })
  })
</script>

<style lang="scss">
  .tabs-container {
    width: 100%;
    position: relative;
    @include media(mobile) {
      border-radius: 0px 0px 20px 20px;
    }

    .tabs {
      display: flex;
      justify-content: flex-start;
      align-items: flex-start;

      // gap: 1rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;

      &-process {
        width: 100%;
        height: 5px;
        background: var(--c-bg-variant);
        z-index: 0;
        position: relative;
        border-radius: 2px;
        .process {
          position: absolute;
          height: 5px;
          border-radius: 2px;
          z-index: 1;
          align-self: flex-start;
          width: 25%;
          background: var(--g-primary-light);
        }
      }

      .tab-btn {
        display: flex;
        position: relative;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        background: none;
        border: none;
        outline: none;
        cursor: pointer;
        flex: 1;
        padding: 0.5rem;
        row-gap: 0.3rem;
        @include media(mobile) {
          transform: scale(0.85);
          padding: 0.5rem 0rem;
        }

        p {
          font-size: medium;
          @include media(mobile) {
            font-size: 1rem;
          }

          &:focus {
            box-shadow: var(--shadow);
          }
        }

        &:focus {
          outline: none;
        }

        span {
          font-size: small;
          color: var(--c-text-muted);
        }
      }

      .tab-btn[aria-selected='true'] {
        color: var(--c-black);
      }

      &-solutions {
        @include media(mobile) {
          position: sticky;
          overflow-y: hidden;
          top: 12.5%;
          z-index: 10;
          width: 100%;
          left: 100%;

          gap: 0rem;
          align-self: self-end;

          box-shadow: var(--shadowX);
          padding-top: 0.6rem;
        }

        .activeTab {
          span {
            color: var(--d7);
            @include media(mobile) {
              color: var(--c-line);
            }
          }
        }

        .tab-title {
          color:var(--c-line);
          @include media(mobile) {
            color: var(--c-line);
            font-size: 0.75rem;
          }
        }

        .tablist {
          @include media(mobile) {
            width: 100%;
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
            overflow: auto;
            border-radius: var(--br);
          }
        }
      }
    }
  }

  .activeTab {
    color: var(--c-black);
    background: transparent;
    autoline: none;
    opacity: 1;
    p {
      color: var(--g-primary);
      font-size: medium;
      background: var(--g-primary-light);
      background-size: 200% 100%;
      background-clip: text;
      -webkit-background-clip: text;
      color: black;
      /* Inicialmente color negro */
      -webkit-text-fill-color: black;
      display: inline-block;
      animation:
        gradient-move 1s ease infinite,
        color-change 1s ease infinite;
      transition:
        color 1s ease,
        -webkit-text-fill-color 1s ease;
    }

    span {
      color: var(--c-black) !important;
    }
  }

  html[data-theme='dark'] .tabs-container {
    .tab-btn {
      background-color: transparent;
      span {
        color: var(--c-text-muted) !important;
        @include media(mobile) {
          color: var(--c-white) !important;
        }
      }
    }
  }

  html[data-theme='dark'] .activeTab {
    .tab-title {
      @include media(mobile) {
        color: var(--c-white) !important;
      }
    }
    span {
      color: var(--c-white) !important;
    }
  }
</style>
