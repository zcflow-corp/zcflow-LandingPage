---
import { Image } from 'astro:assets'
import ThemeSwitch from '../islands/ThemeSwitch.jsx'
import Lang from './Lang.astro'
import { localeHelper } from '../i18n'
import { getImageMetadata } from '@/utils/imageHelper'

const { t, path } = localeHelper(Astro)
const base = import.meta.env.BASE_URL

const [logo_header_darks, logo_header_light] = await Promise.all([
  getImageMetadata('logo_header_darks.webp'),
  getImageMetadata('logo_movil_dark.webp'),
])
---

<header class="site-header" itemscope itemtype="https://schema.org/Organization" transition:persist>
  <div class="container">
    <a href={`${path('')}#hero`} aria-label="Inicio - ZCFlow">
      { 
        logo_header_darks && (
          <Image
            src={logo_header_darks}
            alt="ZCFlow logo dark"
            class="mode-dark responsive-mode-dark"
            width={150}
            height={150}
            loading="lazy"
            decoding="async"
            itemprop="logo"
          />
        )
      }
      {
        logo_header_light && (
          <Image
            src={logo_header_light}
            alt="ZCFlow logo light"
            class="mode-light"
            width={150}
            height={150}
            loading="lazy"
            decoding="async"
            itemprop="logo"
          />
        )
      }
    </a>
    <meta itemprop="name" content="ZCFlow" />
    <meta itemprop="url" content="https://www.zcflow.com" />

    <!-- menú hamburguesa -->
    <div class="container-toggle">
      <button
        class="menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="main-navigation"
      >
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
    <!--Navegación -->
    <nav
      aria-label="Navegación principal"
      class="nav"
      style="display: flex; align-items:center; column-gap: 15px; width: 100%; justify-content:space-between; padding: 1rem 2rem;"
      itemscope
      itemtype="https://schema.org/SiteNavigationElement"
    >
      <ul role="listbox" aria-labelledby="label_items" class="nav-list">
        <li><a href={`${path('')}#zcflow`} itemprop="name">{t('Empresas')}</a></li>
        <!-- <li><a href={`${path('')}#soluciones`} itemprop="name">{t('Socios')}</a></li> -->
        <li><a href={`${path('')}#soluciones`} itemprop="name">{t('Soluciones')}</a></li>
        <li><a href={`${path('')}#fundamentos`} itemprop="name">{t('Fundamentos')}</a></li>
        <li><a href="#" itemprop="name">{t('Ingresar')}</a></li>
      </ul>
      <!--Otras Acciones -->

      <div class="mobile-actions">
        <div style="display: flex;column-gap: 1rem;">
          <Lang client:load transition:persist />
          <ThemeSwitch client:load />
        </div>
        <a class="btn tertiary" href={path('contacto')}>
          {t('Solicita una demo')}
        </a>
      </div>
    </nav>
  </div>
  <script>
    function initHeader() {
      const toggle = document.querySelector('.menu-toggle') as HTMLElement
      const nav = document.querySelector('.nav') as HTMLElement
      if (!toggle || !nav) return

      nav.classList.remove('active')
      toggle.classList.remove('active')

      const handleToggleClick = () => {
        const expanded = toggle.getAttribute('aria-expanded') ? 'true' : 'false'
        toggle.setAttribute('aria-expanded', expanded)
        nav.classList.toggle('active')
        toggle.classList.toggle('active')
      }
      toggle.removeEventListener('click', handleToggleClick)
      toggle.addEventListener('click', handleToggleClick)
    }
    initHeader()
    document.addEventListener('astro:after-swap', initHeader)
  </script>
</header>

<style lang="scss">
  .site-header {
    // position: sticky !important;
    position: fixed !important;
    padding: 0px 0px;
    width: 100%;
    margin: 0 auto;
    // top: 0;
    top: 0 !important;
    height: 80px;
    z-index: 1000;
    // background: red !important;
    border-bottom: none;
    font-weight: 500;
    // backface-visibility: hidden;
    width: 100vw;
    // align-self: flex-start;
    background-color: white;
    transition: background 0.3s ease;
    .container {
      padding: 0rem 2rem;
      gap: 8px !important;
      width: 100%;
      justify-content: space-between;
    }
    .container-toggle {
      display: none;
    }
    .menu-toggle {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 35px;
      height: 13px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      z-index: 2000;
      transition: transform 0.3s ease;
    }

    .menu-toggle .bar {
      height: 2px;
      width: 100%;
      background: var(--c-black);
      // border-radius: 2px;
      transition: all 0.3s ease;
      transform-origin: center;
    }
    .menu-toggle.active .bar:nth-child(1) {
      transform: translateY(3px) rotate(45deg);
    }

    .menu-toggle.active .bar:nth-child(2) {
      transform: translateY(-8px) rotate(-45deg);
    }
    .nav-list {
      display: flex;
      gap: 1.5rem;
      list-style: none;
      color: var(--c-dark);
      margin: 0;
      padding: 0;

      a {
        color: var(--c-dark);
        text-decoration: none;
        transition: color 0.3s ease;

        &:hover {
          color: var(--c-primary-accessible);
          outline: none;
          outline-offset: 2px;

          text-decoration: none;
        }
      }
    }

    .logo .mode-dark,
    .mode-light {
      width: 116%;
      height: 24px;
      object-fit: contain;
    }
    .mobile-actions {
      column-gap: 18px;
      display: flex;
    }
    :global(html[data-theme='light']) .mode-light {
      display: block;
    }

    :global(html[data-theme='dark']) .mode-dark {
      display: block;
    }

    @include media(tablet-down) {
      @include shared-mobile-table;
      :global(html[data-theme='light']) .mode-light {
        display: block;
      }

      :global(html[data-theme='dark']) .mode-light {
        display: block;
      }
      html[data-theme='dark'] .mobile-actions {
        border-top: 1px solid #3a3a3d;
      }

      html[data-theme='light'] .mobile-actions {
        border-top: 1px solid rgba(0, 0, 0, 0.15) !important;
      }
    }

    @include media(tablet) {
      @include shared-mobile-tablet-principales;
    }

    .logo-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 1.25rem;
      align-items: center;
    }
  }
</style>
