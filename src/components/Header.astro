---
import { Image } from 'astro:assets'
import ThemeSwitch from '../islands/ThemeSwitch.jsx'
import Lang from './Lang.astro'

const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k: unknown) => k
const locale = Astro.currentLocale ?? 'es'
const base = import.meta.env.BASE_URL

const path = (url) => `${base}${locale}/${url}/`.replace(/\/+/g, '/')
---

<header class="site-header" itemscope itemtype="https://schema.org/Organization">
  <div class="container">
    <a href=`${base}` aria-label="Inicio - ZCFlow">
      <Image
        src=`${base}assets/logo_header_version_bgdarks.webp`
        alt="ZCFlow logo dark"
        class="mode-responsive"
        width={150}
        height={150}
        loading="lazy"
        decoding="async"
        itemprop="logo"
      />
      <Image
        src=`${base}assets/logo_header_darks.webp`
        alt="ZCFlow logo dark"
        class="mode-dark responsive-mode-dark"
        width={150}
        height={150}
        loading="lazy"
        decoding="async"
        itemprop="logo"
      />
      <Image
        src=`${base}assets/logo_header_light.webp`
        alt="ZCFlow logo light"
        class="mode-light"
        width={150}
        height={150}
        loading="lazy"
        decoding="async"
        itemprop="logo"
      />
    </a>
    <meta itemprop="name" content="ZCFlow" />
    <meta itemprop="url" content="https://www.zcflow.com" />

    <!-- menú hamburguesa -->
    <div class="container-toggle">
      <button
        class="menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="main-navigation"
      >
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
    <!--Navegación -->
    <nav
      aria-label="Navegación principal"
      class="nav"
      style="display: flex; align-items:center; column-gap: 15px; width: 100%; justify-content:space-between; padding: 1rem 2rem;"
      itemscope
      itemtype="https://schema.org/SiteNavigationElement"
    >
      <ul role="listbox" aria-labelledby="label_items" class="nav-list">
        <li><a href="#soluciones" itemprop="name">{t('Empresas')}</a></li>
        <li><a href="#soluciones" itemprop="name">{t('Socios')}</a></li>
        <li><a href="#soluciones" itemprop="name">{t('Soluciones')}</a></li>
        <li><a href="#fundamentos" itemprop="name">{t('Fundamentos')}</a></li>
      </ul>
      <!--Otras Acciones -->
      <div class="mobile-actions">
        <Lang />
        <ThemeSwitch client:idle />
        <a class="btn icon" href="#">{t('Ingresar')}</a>
        <a class="btn tertiary" href={path('contacto')}>
          {t('Solicita una demo')}
        </a>
      </div>
    </nav>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.querySelector('.menu-toggle')
      const nav = document.querySelector('.nav')

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') ? 'true' : 'false'
        toggle.setAttribute('aria-expanded', expanded)
        nav.classList.toggle('active')
        toggle.classList.toggle('active')
      })
    })
  </script>
</header>

<style lang="scss">
  .site-header {
    position: sticky;
    padding: 0px 0px;
    top: 0;
    z-index: 1000;
    border-bottom: none;
    font-weight: 500;

    .container {
      padding: 0rem 2rem;
      gap: 8px !important;
      width: 100%;
      justify-content: space-between;
    }

    .menu-toggle {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 35px;
      height: 13px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      z-index: 2000;
      transition: transform 0.3s ease;
    }

    .menu-toggle .bar {
      height: 2px;
      width: 100%;
      background: var(--c-black);
      // border-radius: 2px;
      transition: all 0.3s ease;
      transform-origin: center;
    }
    .menu-toggle.active .bar:nth-child(1) {
      transform: translateY(3px) rotate(45deg);
    }

    .menu-toggle.active .bar:nth-child(2) {
      transform: translateY(-8px) rotate(-45deg);
    }
    .nav-list {
      display: flex;
      gap: 1.5rem;
      list-style: none;
      color: var(--c-dark);
      margin: 0;
      padding: 0;

      a {
        color: var(--c-dark);
        text-decoration: none;
        transition: color 0.3s ease;

        &:hover {
          color: var(--c-primary-accessible);
          outline: none;
          outline-offset: 2px;

          text-decoration: none;
        }
      }
    }

    .logo .mode-dark,
    .mode-light {
      width: 116%;
      height: 24px;
      object-fit: contain;
    }
    .mobile-actions {
      column-gap: 18px;
      display: flex;
    }
    .mode-responsive {
      display: none;
    }

    @include media(tablet-down) {
      @include shared-mobile-table;
    }
    // @include media(tablet) {
    //   @include shared-mobile-table;
    // }

    @include media(desktop) {
      @include shared-mobile-tablet-principales;
    }

    .logo-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 1.25rem;
      align-items: center;
    }
  }
</style>
