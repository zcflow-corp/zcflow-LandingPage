---
import ThemeSwitch from '../islands/ThemeSwitch.jsx'
import Lang from './Lang.astro'

const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k: any) => k
---

<header class="site-header" itemscope itemtype="https://schema.org/Organization">
  <div class="container">
    <div class="logo">
      <a href="/" aria-label="Inicio - ZCFlow">
        <img
          src="/public/assets/logo_header_darks.webp"
          alt="ZCFlow logo dark"
          class="mode-light"
          width="180"
          height="auto"
          loading="lazy"
          itemprop="logo"
        />
        <img
          src="/public/assets/logo_header_light.webp"
          alt="ZCFlow logo light"
          class="mode-dark"
          width="180"
          height="auto"
          loading="lazy"
          itemprop="logo"
        />
      </a>
      <meta itemprop="name" content="ZCFlow" />
      <meta itemprop="url" content="https://www.zcflow.com" />
    </div>
    <!-- menú hamburguesa -->
    <div class="container-toggle">
      <button
        class="menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="main-navigation"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
    <!--Navegación -->
    <nav
      aria-label="Navegación principal"
      class="nav"
      style="display: flex; align-items:center; column-gap: 15px;"
      itemscope
      itemtype="https://schema.org/SiteNavigationElement"
    >
      <ul role="listbox" aria-labelledby="label_items" class="nav-list">
        <li><a href="#empresas" itemprop="name">{t('Empresas')}</a></li>
        <li><a href="#socios" itemprop="name">{t('Socios')}</a></li>
        <li><a href="#soluciones" itemprop="name">{t('Soluciones')}</a></li>
        <li><a href="#fundamentos" itemprop="name">{t('Fundamentos')}</a></li>
        <li><a href="#about" itemprop="name">{t('Quienes somos')}</a></li>
      </ul>
      <!--Otras Acciones -->
      <div class="mobile-actions">
        <Lang />
        <ThemeSwitch client:idle />
        <a class="btn secondary" href="#demo">Ingresar</a>
        <a class="btn tertiary" href="#demo">Ver demo</a>
      </div>
    </nav>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.querySelector('.menu-toggle')
      const nav = document.querySelector('.nav')

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') ? 'true' : 'false'
        toggle.setAttribute('aria-expanded', expanded)
        nav.classList.toggle('active')
        toggle.classList.toggle('active')
      })
    })
  </script>
</header>

<style lang="scss">
  .site-header {
    background: var(--g-background, #fff);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    position: sticky;
    top: 0;
    z-index: 1000;

    .site-header .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 2rem;
    }

    .menu-toggle {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 28px;
      height: 20px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      z-index: 2000;
      transition: transform 0.3s ease;
    }

    .menu-toggle .bar {
      height: 3px;
      width: 100%;
      background: var(--c-white);
      border-radius: 2px;
      transition: all 0.3s ease;
      transform-origin: center;
    }
    .menu-toggle.active .bar:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .menu-toggle.active .bar:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle.active .bar:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
    .nav-list {
      display: flex;
      gap: 1.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .logo .mode-dark,
    .mode-light {
      width: auto;
      height: 35px;
    }
    .mobile-actions {
      column-gap: 18px;
      display: flex;
    }

    [data-theme='light'] header {
      background-color: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }

    [data-theme='dark'] header {
      background-color: rgba(11, 18, 32, 0.9);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* 3. Control de elementos visibles por tema */
    .mode-dark {
      display: none;
    }

    html[data-theme='dark'] .mode-dark {
      display: block;
    }

    html[data-theme='dark'] .mode-light {
      display: none;
    }
    /* --- Responsive --- */
    @include media(mobile) {
      .menu-toggle {
        display: flex;
        flex-direction: column;
        color: var(--c-white);
      }
      .logo img {
        width: 100px;
        height: 28px;
      }
      .container-toggle {
        width: 63px;
        height: 48px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: var(--c-primary-accessible);
        border-radius: 8px;
      }

      .nav {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background: var(--g-background, #fff);
        display: none;
        flex-direction: column;
        align-items: center;
        padding: 1.5rem 0;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition:
          opacity 0.25s ease,
          transform 0.25s ease,
          visibility 0.25s;
        row-gap: 16px;
      }

      .nav.active {
        display: flex;
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .nav-list {
        flex-direction: column;
        gap: 1rem;
      }

      .actions {
        display: none;
      }

      .mobile-actions {
        flex-direction: column;
        row-gap: 13px;
      }

      .site-header,
      .container {
        width: 100%;
        justify-content: space-between;
        padding: 0px 8px;
      }
      .btn.secondary {
        width: 300px;
      }
      .btn.tertiary {
        width: 300px;
      }
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
