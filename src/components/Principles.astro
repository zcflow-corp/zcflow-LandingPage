---
import { localeHelper } from '../i18n/index'
import principles from '@/data/principles.json'
import { Image } from 'astro:assets'
// const { t: _t } = Astro.props
// const t = typeof _t === 'function' ? _t : (k: unknown) => k
const { locale, t } = localeHelper(Astro)
const base = import.meta.env.BASE_URL
const firstColumnItems = principles.slice(0, 2)
const secondColumnItems = principles.slice(2, 5)
---

<section id="fundamentos" class="section fundamentos" aria-labelledby="fundamentos-title">
  <div class="container container-fundamentos">
    <!-- Encabezado de la sección -->
    <div class="section-header" style="width: 100%;">
      <div class="fundamentos-header">
        <h6 class="gradient-blue-dark">{t('Nuestros fundamentos')}</h6>
        <div class="reveal-wrapper">
          <h2 class="reveal-target" style="margin: 0%;">{t('Los principios que nos guían')}</h2>
        </div>
        <!-- <div class="reveal-wrapper description-wrapper">
          <p class="reveal-target fundamentos-description">
           
          </p>
        </div> -->
        <!-- <div class="btn icon descubre-mas">
          <a href="#fundamentos-card" class="btn" aria-label={t('Descubre más')}>
            {t('Descubre más')}</a
          >
        </div> -->
      </div>
    </div>
    <!-- principios -->
    <div class="container-cards">
      <section
        class="principles"
        style="display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    row-gap: 2rem;"
        aria-labelledby="Lista de principios fundamentales de ZCflow"
      >
        <p>
          {
            t(
              'Sabemos que la confianza en las finanzas nace de la innovación responsable. Por eso, en ZCflow nos regimos por cinco principios que definen cómo diseñamos, operamos y colaboramos. Estos fundamentos no son opcionales: son nuestro compromiso con las empresas y con el futuro.'
            )
          }
        </p>
        {
          firstColumnItems.map((p, index) => (
            <article id="fundamentos-card" class="card principle column-card-first">
              {p.img && (
                <div class={`images-dinamyc${index}`}>
                  <figure>
                    <Image
                      src={`${base}${p.img}`}
                      alt={t(p.title)}
                      width={1200}
                      height={200}
                      class="Image"
                    />
                  </figure>
                </div>
              )}
              <section class="principles-container">
                <span class="keyword">{t(p.key)}</span>
                <div class="section-header">
                  <h3 class="principle-title">{t(p.title)}</h3>
                </div>
                <div class="section-body">
                  <p style="font-size: 1rem;">{t(p.desc)}</p>
                </div>
              </section>
            </article>
          ))
        }
      </section>
      <section
        class="principles column-card-two"
        aria-labelledby="Lista de principios fundamentales de ZCflow"
      >
        {
          secondColumnItems.map((p, index) => (
            <article id="fundamentos-card" class="card principle">
              {p.img && (
                <div class={`images-dinamyc-second${index}`}>
                  <figure>
                    <Image
                      src={`${base}${p.img}`}
                      alt={t(p.title)}
                      width={1200}
                      height={200}
                      class="Image"
                      loading="lazy"
                    />
                  </figure>
                </div>
              )}
              <section class="principles-container">
                <span class="keyword">{t(p.key)}</span>
                <div class="section-header">
                  <h3 class="principle-title">{t(p.title)}</h3>
                </div>
                <div class="section-body">
                  <p style="font-size: 1rem;">{t(p.desc)}</p>
                </div>
              </section>
            </article>
          ))
        }
      </section>
    </div>
  </div>
</section>
<style lang="scss">
  .column-card-first .images-dinamyc0,
  .images-dinamyc1,
  .images-dinamyc-second0,
  .images-dinamyc-second1,
  .images-dinamyc-second2 {
    display: flex;
    background: var(--c-bg-variant);
    border-radius: 2px;
    margin: 0px;
    padding: 12px 12px;
  }
  html[data-theme='light'] .images-dinamyc1 {
    background: var(--c-bg-variant);
  }

  html[data-theme='light'] .images-dinamyc-second0 {
    background: var(--c-bg-variant);
  }

  html[data-theme='light'] .images-dinamyc-second1 {
    background: var(--c-bg-variant);
  }

  html[data-theme='light'] .images-dinamyc-second2 {
    background: var(--c-bg-variant);
  }

  .column-card-first .images-dinamyc0 {
    justify-content: flex-end;
  }

  .column-card-first .images-dinamyc1 {
    justify-content: flex-start;
  }

  .images-dinamyc-second0 {
    justify-content: flex-start;
  }
  html[data-theme='dark'] .column-card-first .images-dinamyc0,
  .images-dinamyc1,
  .images-dinamyc-second0,
  .images-dinamyc-second1,
  .images-dinamyc-second2 {
    background: var(--c-black);
  }
  .images-dinamyc-second1 {
    justify-content: flex-end;
  }
  .images-dinamyc-second2 {
    justify-content: flex-start;
  }

  .column-card-two {
    display: flex;
    flex-wrap: wrap;
    row-gap: 2rem;
  }
  section .column-card-first:first-of-type {
    border-radius: 8px;
  }

  #fundamentos-card {
    background: var(--c-white);
    border-radius: 8px;
    padding: 13px;
  }

  .Image {
    margin: 0;
    width: 80%;
    height: 259px;
  }

  .keyword {
    width: 100%;
    max-width: 16%;
    background: var(--c-bg-variant);
    letter-spacing: 0.8px;
    padding: 8px;
    text-align: center;
    border-radius: 5px;
    font-size: 0.6rem;
    text-align: start;
  }
  .images-dinamyc {
    background: var(--c-bg-variant);
    border-radius: 2px;
    margin: 0px;
    padding: 12px 12px;
    display: flex;
  }

  .container-fundamentos {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    row-gap: 50px;

    // background: var(--c-bg-variant);
  }
  .principles .principle:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .images-dinamyc {
    img {
      width: 100%;
    }
  }

  .principles-container {
    display: flex;
    flex-direction: column;
    row-gap: 8px;
    padding: 13px;
  }

  .fundamentos-header {
    display: flex;
    flex-direction: column;
    align-items: start;
    row-gap: 24px;

    h6 {
      font-size: 1rem;
    }
  }

  .fundamentos-description {
    text-align: center;
    margin: 0;
    width: 100%;
    text-wrap: wrap;

    @include media(tablet) {
      max-width: 710px;
    }
  }

  .descubre-mas {
    text-align: center;
    padding: 0;
  }
  .card {
    figure {
      margin: 0;
      width: 100%;
      max-width: 80%;
      img {
        width: 100%;
        object-fit: cover;
        display: block;
        padding: 0px;
      }
    }
  }

  .fundamentos .reveal-wrapper .reveal-target {
    position: relative;
    text-align: justify;
  }

  /* Breakpoints */

  @include media(mobile) {
    .principles-container .keyword {
      max-width: 31%;
    }
    .images-dinamyc {
      .card {
        figure {
          max-width: 100%;
          img {
            width: 125%;
          }
        }
      }
    }
  }

  @include media(desktop) {
    @include shared-mobile-tablet-principales;
  }

  h6.principales {
    margin: 0px;
    // @include gradient-text-indicadores-base(#0563ff, #90a9d5, var(--d8));
  }
</style>
