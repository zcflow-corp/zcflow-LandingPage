---
import principles from '@/data/principles.json'
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k) => k
---

<section id="fundamentos" class="section fundamentos" aria-labelledby="fundamentos-title">
  <div class="container-fundamentos">
    <!-- Encabezado de la sección -->
    <div class="section-header">
      <div class="fundamentos-header">
        <h6 style="margin: 0%;">{t('Nuestros fundamentos')}</h6>
        <h2 style="margin: 0%;">{t('Los principios que nos guían')}</h2>
      </div>
      <p class="fundamentos-description">
        {
          t(
            'Sabemos que la confianza en las finanzas nace de la innovación responsable. Por eso, en ZCflow nos regimos por cinco principios que definen cómo diseñamos, operamos y colaboramos. Estos fundamentos no son opcionales: son nuestro compromiso con las empresas y con el futuro.'
          )
        }
      </p>
    </div>
    <div class="descubre-mas">
      <a href="#descubre" class="btn" aria-label={t('Descubre más')}>{t('Descubre más')}</a>
    </div>
    <!-- principios -->
    <section class="principles" aria-labelledby="Lista de principios fundamentales de ZCflow">
      {
        principles.map((p) => (
          <article class="card principle" tabindex="0">
            <section class="principles-container">
              <div class="section-header">
                <h3 class="principle-title">{p.title}</h3>
              </div>
              <div class="section-body">
                <p>{p.desc}</p>
              </div>
            </section>

            {p.img && (
              <figure>
                <img src={p.img} alt={p.title} width="100%" height="100%" loading="lazy" />
              </figure>
            )}
          </article>
        ))
      }
    </section>
  </div>
</section>
<style lang="scss">
  .container-fundamentos {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    row-gap: 40px;
  }
  .principles-container {
    display: flex;
    flex-direction: column;
    row-gap: 8px;
    align-items: center;
  }
  .fundamentos-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: 8px;
  }

  @keyframes gradient-move {
    0% {
      background-position: 0% 0;
    }
    50% {
      background-position: 100% 0;
    }
    100% {
      background-position: 0% 0;
    }
  }
  .fundamentos-header h6 {
    background: linear-gradient(90deg, #0563ff 0%, #476aa6 47.12%, #e2e2e2 100%);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.35px;
    font-size: 1rem;
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    animation: gradient-move 15s ease infinite;
  }

  .fundamentos-header h2 {
    font-weight: 500;
    font-size: 3rem;
  }

  .fundamentos-description {
    max-width: 710px;
    text-align: center;
    font-weight: 500;
    letter-spacing: 0.5px;
    line-height: 28px;
    font-size: 1rem;
    margin: 0px;
    line-height: 28px;
  }
  .fundamentos .principles {
    display: grid;
    justify-content: center;
    justify-items: center;
    row-gap: 1.5rem;
    column-gap: 1.5rem;
    padding: 1rem;
  }
  .descubre-mas {
    // height: 45px;
    // border: 2px solid var(--c-black);
    text-align: center;
  }
  .fundamentos {
    padding: 4rem 1.5rem;
  }

  .fundamentos header .fundamentos-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3rem;
  }

  .principles figure img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .principles figure {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0rem;
  }

  // .principles .card:nth-child(-n + 2) {
  //   grid-column: span 2;
  //   height: 450px;
  // }

  // .principles .card:nth-child(n + 3) {
  //   width: 300px;
  //   grid-row: span 1.5;
  // }

  .card figure img {
    max-width: 80%;
    max-height: 80%;
    object-fit: contain;
    display: block;
  }

  .principles .card.principle {
    background: #f6f6f9; /*no existe en la paleta*/
    border-radius: 8px;
    box-shadow: var(--shadow, 0 4px 10px rgba(0, 0, 0, 0.1));
    padding: 1.5rem;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
    cursor: default;
    // display: flex;
    // flex-wrap: wrap;
    // align-items: center;
    // justify-content: center;
    border: none;
  }

  .card.principle:focus-visible,
  .card.principle:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
    outline: none;
  }

  .principles .principle-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 28px;
    color: var(--c-quinary);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: 24px;
  }

  .principles .section-body p {
    margin: 0;
    font-size: 1rem;
    line-height: 22px;
    color: var(--c-secondary);
    text-align: center;
  }
  @include media(desktop) {
    .principles {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .principles .card:nth-child(1),
    .principles .card:nth-child(2) {
      grid-row: 1 / span 1;
      //  display: inline-block;
    }

    .principles .card:nth-child(1) {
      justify-self: end;
    }

    .principles .card:nth-child(2) {
      justify-self: start;
    }

    .principles .card:nth-child(3) {
      grid-column: 1 / 2;
    }
    .principles .card:nth-child(4) {
      grid-column: 2 / 3;
    }
    .principles .card:nth-child(5) {
      grid-column: 3 / 4;
    }
  }

  @include media(mobile) {
    .principles {
      grid-template-columns: 1fr;
      display: inline;
      gap: 2rem;
    }
    .container-fundamentos {
      max-width: 340px;
    }
  }
</style>
