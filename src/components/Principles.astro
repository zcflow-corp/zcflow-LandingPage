---
import principles from '@/data/principles.json'
import { Image } from 'astro:assets'
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k: unknown) => k
const base = import.meta.env.BASE_URL
---

<section id="fundamentos" class="section fundamentos" aria-labelledby="fundamentos-title">
  <div class="container container-fundamentos">
    <!-- Encabezado de la sección -->
    <div class="section-header">
      <div class="fundamentos-header">
        <h6 class="gradient-blue-dark" style="margin: 0%;">{t('Nuestros fundamentos')}</h6>
        <div class="reveal-wrapper">
          <h2 class="reveal-target" style="margin: 0%;">{t('Los principios que nos guían')}</h2>
        </div>
      </div>
      <div class="reveal-wrapper description-wrapper">
        <p class="reveal-target fundamentos-description">
          {
            t(
              'Sabemos que la confianza en las finanzas nace de la innovación responsable. Por eso, en ZCflow nos regimos por cinco principios que definen cómo diseñamos, operamos y colaboramos. Estos fundamentos no son opcionales: son nuestro compromiso con las empresas y con el futuro.'
            )
          }
        </p>
      </div>
    </div>
    <div class="btn icon descubre-mas">
      <a href="#descubre" class="btn" aria-label={t('Descubre más')}> {t('Descubre más')}</a>
    </div>
    <!-- principios -->
    <section class="principles" aria-labelledby="Lista de principios fundamentales de ZCflow">
      {
        principles.map((p) => (
          <article class="card principle">
            <section class="principles-container">
              <div class="section-header">
                <h3 class="principle-title">{t(p.title)}</h3>
              </div>
              <div class="section-body">
                <p>{t(p.desc)}</p>
              </div>
            </section>

            {p.img && (
              <figure class="images-dinamyc">
                <Image
                  src={`${base}${p.img}`}
                  alt={t(p.title)}
                  width={1200}
                  height={200}
                  loading="lazy"
                  class="images-dinamyc"
                />
              </figure>
            )}
          </article>
        ))
      }
    </section>
  </div>
  <script>
    const imageFigure = document.querySelector('.about-image')

    const principlesSection = document.querySelector('.principles')

    const fundamentosSection = document.querySelector('.fundamentos')

    function setupObserver(element) {
      if (!element || !('IntersectionObserver' in window)) return

      const observer = new IntersectionObserver(
        (entries, observerInstance) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              observerInstance.unobserve(entry.target)
            }
          })
        },
        {
          root: null,
          rootMargin: '0px',
          threshold: 0.1,
        }
      )
      observer.observe(element)
    }

    setupObserver(imageFigure)
    setupObserver(principlesSection)

    setupObserver(fundamentosSection)
  </script>
</section>
<style lang="scss">
  .container-fundamentos {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .images-dinamyc {
    width: 100%;
    max-width: 100%;

    img {
      width: 100%;
      height: auto;
    }
  }

  .principles-container {
    display: flex;
    flex-direction: column;
    row-gap: 8px;
    align-items: center;
    // padding: 0 0 20px 0;
  }

  .fundamentos-header {
    display: flex;
    flex-direction: column;
    align-items: center;

    h6 {
      font-size: 1rem;
    }
  }

  .fundamentos-description {
    text-align: center;
    margin: 0;
    width: 100%;
    text-wrap: wrap;

    @include media(tablet) {
      max-width: 710px;
    }
  }

  .fundamentos {
    .principles {
      display: grid;
      justify-content: center;
      justify-items: center;
      row-gap: 1.5rem;
      column-gap: 1.5rem;
    }

    header {
      .fundamentos-header {
        text-align: center;
      }
    }

    .reveal-wrapper {
      overflow: hidden;
    }
  }

  .descubre-mas {
    text-align: center;
    padding: 0;
  }

  .principles {
    figure {
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 0;

      img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
      }
    }

    .card.principle {
      background: var(--c-bg-variant);
      border-radius: 8px;
      padding: 1.5rem;
      cursor: default;
      border: none;
      outline: none;

      &:focus,
      &:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow);

        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease;
      }
    }

    .principle-title {
      font-size: 1.25rem;
      font-weight: 600;
      line-height: 28px;
      color: var(--c-black);
    }

    .section-body {
      p {
        margin: 0;
        font-size: 1rem;
        line-height: 22px;
        color: var(--c-secondary);
        text-align: center;
      }
    }
  }

  .card {
    figure {
      img {
        max-width: 80%;
        max-height: 80%;
        object-fit: contain;
        display: block;
      }
    }
  }

  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    align-items: self-start;

    @include media(tablet) {
      align-items: center;
    }
  }

  .fundamentos .reveal-wrapper .reveal-target {
    position: relative;
  }

  /* Breakpoints */

  @include media(desktop) {
    @include shared-mobile-tablet-principales;
  }

  @include media(mobile) {
    .principles {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;

      > .principle:nth-child(n) {
        grid-column: auto;
        grid-row: auto;
      }
    }

    .reveal-target {
      text-align: start;
    }

    .fundamentos-header {
      align-items: flex-start;
    }
  }
</style>
