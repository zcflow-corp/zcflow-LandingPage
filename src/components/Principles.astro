---
import principles from '@/data/principles.json'
import { Image } from 'astro:assets'
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k: unknown) => k
const base = import.meta.env.BASE_URL
const firstColumnItems = principles.slice(0, 2)
const secondColumnItems = principles.slice(2, 5)
---

<section id="fundamentos" class="section fundamentos" aria-labelledby="fundamentos-title">
  <div class="container container-fundamentos">
    <!-- Encabezado de la sección -->
    <div class="section-header" style="width: 100%;">
      <div class="fundamentos-header">
        <h6 class="gradient-blue-dark" style="margin: 0%;">{t('Nuestros fundamentos')}</h6>
        <div class="reveal-wrapper">
          <h2 class="reveal-target" style="margin: 0%;">{t('Los principios que nos guían')}</h2>
        </div>
        <div class="reveal-wrapper description-wrapper">
          <p class="reveal-target fundamentos-description">
            {
              t(
                'Sabemos que la confianza en las finanzas nace de la innovación responsable. Por eso, en ZCflow nos regimos por cinco principios que definen cómo diseñamos, operamos y colaboramos. Estos fundamentos no son opcionales: son nuestro compromiso con las empresas y con el futuro.'
              )
            }
          </p>
        </div>
        <!-- <div class="btn icon descubre-mas">
          <a href="#fundamentos-card" class="btn" aria-label={t('Descubre más')}>
            {t('Descubre más')}</a
          >
        </div> -->
      </div>
    </div>
    <!-- principios -->
    <section class="principles" aria-labelledby="Lista de principios fundamentales de ZCflow">
      {
        firstColumnItems.map((p, index) => (
          <article id="fundamentos-card" class="card principle">
            {p.img && (
              <figure class="images-dinamyc">
                <Image
                  src={`${base}${p.img}`}
                  alt={t(p.title)}
                  width={1200}
                  height={200}
                  loading="lazy"
                  class="images-dinamyc"
                />
              </figure>
            )}
            <section class="principles-container">
              <span class="keyword">{p.key}</span>
              <div class="section-header">
                <h3 class="principle-title">{t(p.title)}</h3>
              </div>
              <div class="section-body">
                <p style="font-size: 1rem;">{t(p.desc)}</p>
              </div>
            </section>
          </article>
        ))
      }
    </section>
    <section class="principles" aria-labelledby="Lista de principios fundamentales de ZCflow">
      {
        secondColumnItems.map((p, index) => (
          <article id="fundamentos-card" class="card principle">
            {p.img && (
              <figure class="images-dinamyc">
                <Image
                  src={`${base}${p.img}`}
                  alt={t(p.title)}
                  width={1200}
                  height={200}
                  loading="lazy"
                  class="images-dinamyc"
                />
              </figure>
            )}
            <section class="principles-container">
              <span class="keyword">{p.key}</span>
              <div class="section-header">
                <h3 class="principle-title">{t(p.title)}</h3>
              </div>
              <div class="section-body">
                <p style="font-size: 1rem;">{t(p.desc)}</p>
              </div>
            </section>
          </article>
        ))
      }
    </section>
  </div>
  <script>
    const imageFigure = document.querySelector('.about-image')

    const principlesSection = document.querySelector('.principles')

    const fundamentosSection = document.querySelector('.fundamentos')

    function setupObserver(element) {
      if (!element || !('IntersectionObserver' in window)) return

      const observer = new IntersectionObserver(
        (entries, observerInstance) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              observerInstance.unobserve(entry.target)
            }
          })
        },
        {
          root: null,
          rootMargin: '0px',
          threshold: 0.1,
        }
      )
      observer.observe(element)
    }

    setupObserver(imageFigure)
    setupObserver(principlesSection)

    setupObserver(fundamentosSection)
  </script>
</section>
<style lang="scss">
  #fundamentos-card:nth-child(1) {
    margin-top: 130px;
    max-height: 500px;
    border-radius: 8px;
    padding: 13px;
  }

  #fundamentos-card {
    background: var(--c-white);
    max-height: 500px;
    border-radius: 8px;
  }

  .keyword {
    background: var(--c-bg-variant);
    padding: 10px;
    max-width: 23%;
    text-align: center;
    border-radius: 5px;
    font-size: 0.8rem;
  }
  .images-dinamyc {
    background: var(--c-bg-variant);
    border-radius: 2px;
  }
  .container-fundamentos {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    row-gap: 64px;
    background: var(--c-bg-variant);
  }
  .principles .principle:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .images-dinamyc {
    img {
      width: 100%;
      height: auto;
    }
  }

  .principles-container {
    display: flex;
    flex-direction: column;
    row-gap: 8px;
    padding: 32px;
  }

  @include media(mobile) {
    #fundamentos-card:nth-child(1) {
      margin: 0px;
    }
    .container-fundamentos {
      row-gap: 15px;
    }
  }

  .fundamentos-header {
    display: flex;
    flex-direction: column;
    align-items: start;
    row-gap: 24px;

    h6 {
      font-size: 1rem;
    }
  }

  .fundamentos-description {
    text-align: center;
    margin: 0;
    width: 100%;
    text-wrap: wrap;

    @include media(tablet) {
      max-width: 710px;
    }
  }

  .descubre-mas {
    text-align: center;
    padding: 0;
  }

  .card {
    figure {
      img {
        max-width: 80%;
        max-height: 80%;
        object-fit: contain;
        display: block;
      }
    }
  }

  .fundamentos .reveal-wrapper .reveal-target {
    position: relative;
    text-align: justify;
  }

  /* Breakpoints */

  @include media(desktop) {
    @include shared-mobile-tablet-principales;
  }
</style>
