---
import LineChart from '@/islands/LineChart.jsx';
import CounterOnView from '@/islands/CounterOnView.jsx';
const { t: _t } = Astro.props;
const t = typeof _t === 'function' ? _t : (k) => k;
---

<section id="indicadores" class="section">
  <div class="container indicators card">
    <h2>{t('Los resultados que importan')}</h2>
    <p>{t('Con ZCflow llevas tu tesorería al siguiente nivel, transformando datos dispersos en información precisa para tomar decisiones estratégicas.')}</p>
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr));align-items:center">
      <div class="card"><LineChart client:visible /></div>
      <div>
        <div class="counter"><CounterOnView client:visible end={70} suffix="%" /></div>
        <p>Visibilidad y control</p>
        <div class="counter"><CounterOnView client:visible end={80} suffix="%" /></div>
        <p>ROI en 6–9 meses</p>
        <div class="counter"><CounterOnView client:visible end={15} suffix="%" /></div>
        <p>Menos costos por cobranza</p>
      </div>
    </div>
  </div>
</section>
