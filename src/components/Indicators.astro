---
import LineChart from '@/islands/LineChart.jsx'
import CounterOnView from '@/islands/CounterOnView.jsx'
import ChartIndicator from './grafic/ChartIndicator.astro'
import { Image } from 'astro:assets'
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k) => k
---

<!-- Original id="indicadores" -->
<section class="section" aria-labelledby="indicadores-title">
  <div style="padding: 2rem;">
    <div class="container indicators card">
      <h4 class="gradient-blue-dark">{'Indicadores'}</h4>
      <div class="section-grafico">
        <div class="section-grafico-left">
          <!-- Original id="indicadores-title" -->
          <h2 class="indicators-title">{t('Los resultados que importan')}</h2>
          <p>
            {
              t(
                'Con ZCflow llevas tu tesorería al siguiente nivel, transformando datos dispersos en información precisa para tomar decisiones estratégicas.'
              )
            }
          </p>
        </div>
        <!-- Gráfico de línea con descripción -->
        <div class="section-grafico-indicador">
          <figure style="align-self: flex-end; margin:0%">
            <LineChart
              client:visible
              aria-label={t('Gráfico de línea mostrando indicadores financieros clave')}
            />
          </figure>

          <div>
            <ChartIndicator year={2025} />
          </div>
        </div>
      </div>
      <!-- Contadores con roles y aria-labels -->
      <div class="container-counter">
        <div class="counter" role="region" aria-label="Visibilidad y control: 70%">
          <div class="gradient-border-left">
            <CounterOnView client:visible end={70} suffix="%" />
          </div>
          <p>{t('Visibilidad y control')}</p>
        </div>

        <div class="counter" role="region" aria-label="ROI en 6–9 meses: 80%">
          <div class="gradient-border-left">
            <CounterOnView client:visible end={80} suffix="%" />
          </div>
          <p>{t('Eficiencia operacional')}</p>
        </div>

        <div class="counter" role="region" aria-label="Menos costos por cobranza: -15%">
          <div class="gradient-border-left">
            <CounterOnView client:visible end={-15} suffix="%" />
          </div>
          <p>{t('Reducción de Gastos')}</p>
        </div>

        <div class="counter" role="region" aria-label="Menos costos por riesgo: 15%">
          <div class="gradient-border-left">
            <CounterOnView client:visible end={-30} suffix="%" />
          </div>
          <p>{t('Mitigación de Riesgo')}</p>
        </div>
      </div>
    </div>
  </div>
</section>
<style lang="scss">
  .section-grafico-left {
    max-width: 41%;
    align-self: center;
  }
  .indicators {
    background: #141417 !important;
    border: 1px solid #3a3a3d;
    flex-direction: column;
    color: var(--c-bg);
    padding: 2rem 3rem;
    border-radius: var(--radius);

    max-width: 950px;

    @include media(mobile) {
      padding: 1rem;
    }
  }
  .gradient-border-left p {
    margin: 0px;
    padding: 7px 0px;
  }
  .gradient-border-left p {
    margin: 0px;
    padding: 7px 0px;
  }
  .indicators h4 {
    align-self: self-start;
    font-weight: bold;
    font-size: 1rem;
    line-height: 28px;
    margin: 0;
    height: 40px;
    // @include gradient-text-indicadores-base(#0563ff, #90a9d5, #f6f6f9);
  }

  .imagen-indicador {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1.2s ease-out,
      transform 1.2s ease-out;
  }
  .imagen-indicador.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .imagen-indicador {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }

  .imagen-indicador {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1.2s ease-out,
      transform 1.2s ease-out;
  }
  .imagen-indicador.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .imagen-indicador {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
  .indicators-title {
    color: var(--c-white);

    @include media(tablet) {
      max-width: 250px;
    }
  }

  .container-counter p {
    color: var(--c-bg);
    width: 100%;
    text-wrap: wrap;

    @include media(mobile) {
      padding: 1rem;
      width: 100%;
    }
  }
  .style-indicators {
    border-left: 2px solid var(--g-primary-dark);
  }
  .container-counter {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-top: 3rem;
    @include media(mobile) {
      padding: 0px 1rem;
    }

    // @include media(tablet) {
    //
    // }
  }
  .section-grafico {
    display: flex;

    align-items: start;
    padding: 1rem 0;
    // gap: 2rem;
    justify-content: space-between;
    width: 100%;
    text-wrap: wrap;
    flex-wrap: wrap;
    .section-grafico-indicador {
      width: 55%;
    }
  }

  @include media(mobile) {
    .section-grafico-left {
      max-width: 100%;
    }
  }

  .section-grafico p {
    color: #c4c4c4;
  }

  .gradient-border-left {
    position: relative;
    padding-left: 12px;
  }

  .counter p {
    font-size: 0.8rem;
    font-weight: normal;
    padding: 0px 12.5px;
  }
  .counter {
    font-size: 2rem;
    font-weight: 800;
  }
  .counter.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .counter {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .counter {
      transition: none;
      transform: none;
    }
  }
  @include media(mobile) {
    .container-counter {
      .counter.is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      .counter {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .counter {
      transition: none;
      transform: none;
    }
  }
  @include media(mobile) {
    .container-counter {
      display: grid;
      grid-template-columns: repeat(2, 1fr); /* 2 columnas iguales */
      gap: 2rem;
      width: 100%;
      padding: 0rem;
    }

    .container-counter {
      transform: scale(0.9);
    }
    .section-grafico {
      .section-grafico-indicador {
        width: 100%;
        margin-top: 2rem;
      }
    }
  }

  html[data-theme='dark'] .indicators {
    color: var(--c-white) !important;
  }
</style>
