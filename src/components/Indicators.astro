---
import LineChart from '@/islands/LineChart.jsx'
import CounterOnView from '@/islands/CounterOnView.jsx'
import { Image } from 'astro:assets'
const { t: _t } = Astro.props
const t = typeof _t === 'function' ? _t : (k) => k
---

<!-- Original id="indicadores" -->
<section class="section" aria-labelledby="indicadores-title">
  <div style="padding: 2rem;">
    <div class="container indicators card">
      <h4>{'Indicadores'}</h4>
      <div class="section-grafico">
        <div>
          <!-- Original id="indicadores-title" -->
          <h2 class="indicators-title">{t('Los resultados que importan')}</h2>
          <p>
            {
              t(
                'Con ZCflow llevas tu tesorería al siguiente nivel, transformando datos dispersos en información precisa para tomar decisiones estratégicas.'
              )
            }
          </p>
        </div>
        <!-- Gráfico de línea con descripción -->
        <div class="section-grafico-indicador">
          <figure style="align-self: flex-end; margin:0%">
            <LineChart
              client:visible
              aria-label="Gráfico de línea mostrando indicadores financieros clave"
            />
          </figure>
          <Image
            src="/assets/indicadores.svg"
            alt={t('Indicadores financieros clave de ZCflow')}
            decoding="async"
            itemprop="logo"
            class="imagen-indicador"
            width="494"
            height="240"
          />
        </div>
      </div>
      <!-- Contadores con roles y aria-labels -->
      <div class="container-counter">
        <div class="counter" role="region" aria-label="Visibilidad y control: 70%">
          <div class="gradient-border-left">
            <CounterOnView client:visible end={70} suffix="%" />
          </div>
          <p>{t('Visibilidad y control')}</p>
        </div>

        <div class="counter" role="region" aria-label="ROI en 6–9 meses: 80%">
          <div class="gradient-border-left">
            <CounterOnView client:visible end={80} suffix="%" />
          </div>
          <p>{t('Eficiencia')}</p>
        </div>

        <div class="counter" role="region" aria-label="Menos costos por cobranza: -15%">
          <div class="gradient-border-left">
            <CounterOnView client:visible end={-15} suffix="%" />
          </div>
          <p>{t('Gastos')}</p>
          <p>✓ {t('Ahorro potencial en comisiones bancarias')}</p>
          <p>✓ {t('Control en tiempo real')}</p>
        </div>

        <div class="counter" role="region" aria-label="Menos costos por riesgo: 15%">
          <div class="gradient-border-left">
            <CounterOnView client:visible end={-30} suffix="%" />
          </div>
          <p>{t('Riesgo')}</p>
          <p>✓ {t('Protege el cash flow')}</p>
        </div>
      </div>
    </div>
  </div>
</section>
<style lang="scss">
  .indicators {
    background: #141417 !important;

    border: 1px solid #3a3a3d;
    flex-direction: column;
    color: var(--c-bg);
  }
  .gradient-border-left p {
    margin: 0px;
    padding: 7px 0px;
  }
  .indicators h4 {
    background: linear-gradient(90deg, #0563ff 19.23%, #90a9d5 43.75%, #f6f6f9 83.65%);
    align-self: self-start;
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 28px;
    margin: 0;
    padding: 10px 50px;
    height: 40px;
    font-weight: bold;
    letter-spacing: 0.35px;
    font-size: 1rem;
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    animation: gradient-move 15s ease infinite;
  }
  @keyframes gradient-move {
    0% {
      background-position: 0% 0;
    }
    50% {
      background-position: 100% 0;
    }
    100% {
      background-position: 0% 0;
    }
  }

  .imagen-indicador {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1.2s ease-out,
      transform 1.2s ease-out;
  }
  .imagen-indicador.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .imagen-indicador {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
  .indicators-title {
    color: #eaf0ff;
    max-width: 250px;
    line-height: 48px;
    font-weight: 500;
  }
  .container-counter p {
    color: #eaf0ff;
  }
  .style-indicators {
    border-left: 2px solid
      linear-gradient(270deg, #52c41a 0%, #00b8d9 19.71%, #00b8d9 59.62%, #7faeff 90.38%);
  }
  .container-counter {
    display: flex;
    justify-content: space-between;
    padding: 0px 50px;
    width: 100%;

    @include media(mobile) {
      padding: 0px 1rem;
    }
  }
  .section-grafico {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    align-items: start;
    font-size: 2rem;
  }
  .section-grafico div {
    width: 100%;
    padding: 0px 50px;
    @include media(mobile) {
      padding: 0px 1rem;
    }
  }
  .section-grafico p {
    color: #eaf0ff;
    font-size: 1rem;
    font-weight: 400;
    line-height: 28px;
    text-justify: inter-word;
  }

  .gradient-border-left {
    position: relative;
    padding-left: 12px;
  }
  .gradient-border-left::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 100%;
    background: linear-gradient(270deg, #52c41a 0%, #00b8d9 19.71%, #00b8d9 59.62%, #7faeff 90.38%);
  }

  .counter p {
    font-size: 0.8rem;
    font-weight: normal;
    padding: 0px 12.5px;
  }
  .counter {
    font-size: 2rem;
    font-weight: 800;
  }
  .counter.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .counter {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .counter {
      transition: none;
      transform: none;
    }
  }
  @include media(mobile) {
    .container-counter {
      flex-direction: column;
    }
    .section-grafico {
      grid-template-columns: 1fr;
    }
  }

  html[data-theme='dark'] .indicators {
    color: var(--c-white) !important;
  }
</style>
