---
const { t: _t, texts = [] } = Astro.props
const t = typeof _t === 'function' ? _t : (k: string) => k
---

<section id="hero-flow" class="hero hero--flow" data-phrases={JSON.stringify(texts)}>
  <canvas class="hero__canvas"></canvas>

  <!-- Nodos -->
  <div class="hero__node hero__node--conecta" data-node="conecta">{t('Conecta')}</div>
  <div class="hero__node hero__node--gestiona" data-node="gestiona">{t('Gestiona')}</div>
  <div class="hero__node hero__node--optimiza" data-node="optimiza">{t('Optimiza')}</div>
  <div class="hero__node hero__node--actua" data-node="actua">{t('Actúa')}</div>

  <!-- Buscador -->
  <div class="hero__search hero__search--hidden">
    <input class="hero__search-input" type="text" disabled />
    <button class="hero__search-button">BOTO</button>
  </div>
</section>

<script>
  ;(function () {
    const root = document.getElementById('hero-flow')
    if (!root) return

    const canvas = root.querySelector('.hero__canvas')
    if (!canvas) return
    const ctx = canvas.getContext('2d')

    let w, h
    function resize() {
      w = canvas.width = root.clientWidth
      h = canvas.height = root.clientHeight
    }
    resize()
    window.addEventListener('resize', resize)

    // Nodos
    const nodeKeys = ['conecta', 'gestiona', 'optimiza', 'actua']
    const nodes = nodeKeys.map((key) => root.querySelector(`[data-node="${key}"]`))

    function activateNode(index) {
      if (!nodes[index]) return
      nodes[index].classList.add('hero__node--active')
    }

    const searchBox = root.querySelector('.hero__search')
    const input = root.querySelector('.hero__search-input')

    async function startSequence() {
      // conecta
      activateNode(0)
      await new Promise((r) => setTimeout(r, 1200))
      // gestiona
      activateNode(1)
      await new Promise((r) => setTimeout(r, 1200))
      // optimiza
      activateNode(2)
      await new Promise((r) => setTimeout(r, 1200))
      // actua
      activateNode(3)

      // mostrar buscador
      setTimeout(() => {
        if (searchBox) {
          searchBox.classList.remove('hero__search--hidden')
          startTypewriter()
        }
      }, 900)
    }

    // Máquina de escribir
    const rawPhrases = root.dataset.phrases || '[]'
    let phrases
    try {
      phrases = JSON.parse(rawPhrases)
    } catch {
      phrases = []
    }

    let pIndex = 0
    let charIndex = 0

    function typePhrase() {
      if (!input || !phrases.length) return

      const phrase = phrases[pIndex]
      if (charIndex < phrase.length) {
        input.value += phrase.charAt(charIndex)
        charIndex++
        setTimeout(typePhrase, 45)
      } else {
        setTimeout(deletePhrase, 1000)
      }
    }

    function deletePhrase() {
      if (!input || !phrases.length) return

      if (charIndex > 0) {
        input.value = input.value.slice(0, -1)
        charIndex--
        setTimeout(deletePhrase, 20)
      } else {
        pIndex = (pIndex + 1) % phrases.length
        setTimeout(typePhrase, 450)
      }
    }

    function startTypewriter() {
      if (!phrases.length) return
      input.value = ''
      pIndex = 0
      charIndex = 0
      typePhrase()
    }

    startSequence()
  })()
</script>

<style lang="scss">
  .hero {
    &--flow {
      position: relative;
      min-height: 30px;
      width: 100%;
      // z-index: -10;

      @include media(tablet) {
        overflow: hidden;
        background-size: contain;
        background-position: top center;
      }

      @include media(desktop) {
        overflow: hidden;
        background-size: contain;
        background-position: top;
      }

      @include media(extradesktop) {
        background-size: contain;

        // background-size: contain;
      }
    }

    &__canvas {
      width: 100%;
      height: 62vh;
      min-width: 20rem;
      @include media(tablet-down) {
        height: 80vh;
        min-width: 100%;
      }

      @include media(extradesktop) {
        // min-height: 80vh;
        min-height: 69vh;
      }
    }

    &__sparkles {
      position: absolute;
      left: 12%;
      top: 55%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    &__sparkle {
      position: absolute;
      display: block;
      border-radius: 999px;
      box-shadow: 0 0 18px rgba(0, 92, 255, 0.7);

      &--big {
        width: 32px;
        height: 32px;
        border-radius: 4px;
        border: 1px solid #005cff;
        transform: rotate(45deg);
        animation: hero-sparkle 2.4s ease-in-out infinite;
      }

      &--medium {
        width: 20px;
        height: 20px;
        border-radius: 4px;
        border: 2px solid #005cff;
        transform: rotate(45deg);
        top: -26px;
        left: -20px;
        animation: hero-sparkle 2.6s ease-in-out infinite;
      }

      &--small {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        border: 2px solid #005cff;
        transform: rotate(45deg);
        top: 24px;
        left: 18px;
        animation: hero-sparkle 2.2s ease-in-out infinite;
      }
    }

    &__node {
      position: absolute;
      padding: 6px 16px;
      border-radius: 999px;
      border: 2px solid #005cff;
      background: #ffffff;
      color: #0050c8;
      font-weight: 600;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.2;
      filter: blur(1.5px);
      transform: translate(-5%, -40%);
      transition:
        opacity 0.5s ease,
        filter 0.5s ease,
        transform 0.5s ease,
        box-shadow 0.5s ease;

      &::before {
        content: '';
        position: absolute;
        right: 100%;
        margin-right: 10px;
        width: 25px;
        height: 25px;
        background: linear-gradient(145deg, #00329f, #0d6bff);
        transform: rotate(90deg);
        border-radius: 4px;

        /* Hexágono */
        clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
        /* Sin glow inicial, lo manejamos con animación */
        box-shadow: 0 0 0 0 rgba(5, 69, 200, 0);
      }

      &--conecta {
        top: 78%;
        left: 25%;

        @include media(tablet) {
          top: 45%;
          left: 26%;
        }

        @include media(desktop) {
          top: 64%;
          left: 30%;
        }

        @include media(extradesktop) {
          // top: 40%;
          top: 55%;
          left: 30%;
        }

        &::before {
          right: -50%;
          bottom: 10%;
          margin-right: 10px;
        }
      }

      &--gestiona {
        // top: 25%;
        // left: 95%;

        @include media(mobile) {
          top: 60%;
          left: 90%;
        }

        @include media(tablet) {
          top: 60%;
          left: 65%;
        }

        @include media(extradesktop) {
          left: 55%;
        }
      }

      &--optimiza {
        top: 45%;
        left: 80%;

        @include media(tablet) {
          top: 38%;
          left: 80%;
        }
        @include media(extradesktop) {
          top: 55%;
        }
      }

      &--actua {
        top: 20%;
        left: 90%;

        @include media(tablet) {
          top: 60%;
          left: 77%;
        }
        @include media(desktop) {
          top: 22%;
          left: 70%;
        }

        @include media(extradesktop) {
          top: 45%;
        }
      }

      &--active {
        opacity: 1;
        filter: blur(0);

        @include media(mobile) {
          transform: translate(-100%, -145%) scale(0.9);
        }

        @include media(desktop) {
          transform: translate(5%, -100%) scale(0.85);
        }

        @include media(extradesktop) {
          transform: translate(-10%, -300%) scale(0.75);
        }

        /* Glow resplandeciente de 3 segundos en el hexágono */
        &::before {
          animation: hero-hex-glow 3s ease-out forwards;
        }
      }
    }

    &__search {
      position: absolute;
      display: flex;
      align-items: center;
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.92);
      box-shadow: var(--shadowXL);
      backdrop-filter: blur(18px);
      transition:
        opacity 0.6s ease,
        transform 0.6s ease;
      opacity: 1;
      transform: scale(0.68);
      padding: 0.75em 0.75em;
      left: -15%;
      bottom: 10%;
      width: max-content;
      gap: 0.25rem;
      justify-content: space-between;

      @include media(tablet) {
        transform: scale(0.9);
        gap: 0.5rem;
        padding: 0.75em 1em;
        font-size: smaller;
        width: 80%;
        left: 0%;
      }

      @include media(desktop) {
        // transform: translate(-50%, 0);
        transform: scale(0.75);
        width: 85%;
        left: 8%;
        bottom: 12%;
      }

      @include media(extradesktop) {
        transform: scale(0.95);
        width: 90%;
        left: 10%;
        bottom: 35%;
      }

      &--hidden {
        opacity: 0;
        transform: translate(-50%, 26px);
        pointer-events: none;
      }
    }

    &__search-input {
      width: clamp(250px, 35vw, 500px);
      height: 40px;
      border-radius: 999px;
      border: none;
      width: 19rem;
      color: var(--c-quinary);
      outline: none;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.02);
      transform: scale(1);
      padding: 0 0.5rem;
      font-size: 0.75rem;

      @include media(tablet) {
        padding: 0 1rem;
        width: 100%;
        font-size: 1rem;
      }

      @include media(desktop) {
        font-size: 1rem;
        font-weight: 500;
      }

      &::placeholder {
        color: rgba(16, 32, 64, 0.45);
      }
    }

    &__search-button {
      min-width: 80px;
      height: 40px;
      border-radius: 10px;
      border: none;
      padding: 0 1em;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      font-size: 0.75rem;
      color: #ffffff;
      background: linear-gradient(135deg, #005cff, #8a2dfc);
      cursor: default;
    }
  }
  html[data-theme='dark'] .hero {
    .hero__search {
      background: var(--c-quinary);

      &-input {
        color: var(--c-tertiary);
      }
    }

    .hero__node {
      background: transparent;
      color: var(--c-tertiary);
    }
  }

  @keyframes hero-sparkle {
    0%,
    100% {
      transform: rotate(45deg) scale(1);
      opacity: 0.7;
    }
    50% {
      transform: rotate(45deg) scale(1.25);
      opacity: 1;
    }
  }

  /* Glow MUY visible del hexágono durante 3 segundos */
  @keyframes hero-hex-glow {
    0% {
      box-shadow: 0 0 0 0 rgba(5, 69, 200, 0);
    }
    20% {
      box-shadow:
        0 0 16px 6px rgba(5, 69, 200, 0.95),
        0 0 28px 10px rgba(5, 69, 200, 0.85);
    }
    60% {
      box-shadow:
        0 0 10px 4px rgba(5, 69, 200, 0.7),
        0 0 20px 8px rgba(5, 69, 200, 0.5);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(5, 69, 200, 0);
    }
  }
</style>
