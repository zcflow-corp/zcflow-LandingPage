---
/**
 * HeroFlow.astro
 * Props:
 * - texts: string[]
 * - t?: (k: string) => string
 */

const { t: _t, texts = [] } = Astro.props
const t = typeof _t === 'function' ? _t : (k: string) => k
---

<section id="hero-flow" class="hero hero--flow" data-phrases={JSON.stringify(texts)}>
  <canvas class="hero__canvas"></canvas>

  <!-- Nodos -->
  <div class="hero__node hero__node--conecta" data-node="conecta">{t('Conecta')}</div>
  <div class="hero__node hero__node--gestiona" data-node="gestiona">{t('Gestiona')}</div>
  <div class="hero__node hero__node--optimiza" data-node="optimiza">{t('Optimiza')}</div>
  <div class="hero__node hero__node--actua" data-node="actua">{t('Actúa')}</div>

  <!-- Buscador -->
  <div class="hero__search hero__search--hidden">
    <input class="hero__search-input" type="text" disabled />
    <button class="hero__search-button">BOTO</button>
  </div>
</section>

<script>
  ;(function () {
    const root = document.getElementById('hero-flow')
    if (!root) return

    const canvas = root.querySelector('.hero__canvas')
    if (!canvas) return
    const ctx = canvas.getContext('2d')

    let w, h
    function resize() {
      w = canvas.width = root.clientWidth
      h = canvas.height = root.clientHeight
    }
    resize()
    window.addEventListener('resize', resize)

    // Nodos
    const nodeKeys = ['conecta', 'gestiona', 'optimiza', 'actua']
    const nodes = nodeKeys.map((key) => root.querySelector(`[data-node="${key}"]`))

    function activateNode(index) {
      if (!nodes[index]) return
      nodes[index].classList.add('hero__node--active')
    }

    const searchBox = root.querySelector('.hero__search')
    const input = root.querySelector('.hero__search-input')

    async function startSequence() {
      // conecta
      activateNode(0)
      await new Promise((r) => setTimeout(r, 1200))
      // gestiona
      activateNode(1)
      await new Promise((r) => setTimeout(r, 1200))
      // optimiza
      activateNode(2)
      await new Promise((r) => setTimeout(r, 1200))
      // actua
      activateNode(3)

      // mostrar buscador
      setTimeout(() => {
        if (searchBox) {
          searchBox.classList.remove('hero__search--hidden')
          startTypewriter()
        }
      }, 900)
    }

    // Máquina de escribir
    const rawPhrases = root.dataset.phrases || '[]'
    let phrases
    try {
      phrases = JSON.parse(rawPhrases)
    } catch {
      phrases = []
    }

    let pIndex = 0
    let charIndex = 0

    function typePhrase() {
      if (!input || !phrases.length) return

      const phrase = phrases[pIndex]
      if (charIndex < phrase.length) {
        input.value += phrase.charAt(charIndex)
        charIndex++
        setTimeout(typePhrase, 45)
      } else {
        setTimeout(deletePhrase, 1000)
      }
    }

    function deletePhrase() {
      if (!input || !phrases.length) return

      if (charIndex > 0) {
        input.value = input.value.slice(0, -1)
        charIndex--
        setTimeout(deletePhrase, 20)
      } else {
        pIndex = (pIndex + 1) % phrases.length
        setTimeout(typePhrase, 450)
      }
    }

    function startTypewriter() {
      if (!phrases.length) return
      input.value = ''
      pIndex = 0
      charIndex = 0
      typePhrase()
    }

    startSequence()
  })()
</script>

<style lang="scss">
  .hero {
    &--flow {
      position: relative;
      width: 92%;
      height: 85vh;
      min-height: 50px;
      overflow: hidden;
      background: transparent;
      background-image: url('/zcflow-LandingPage/assets/section_hero_flow.svg');
      background-repeat: no-repeat;
      background-size: cover;
      background-position: top left;
    }

    &__sparkles {
      position: absolute;
      left: 12%;
      top: 55%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    &__sparkle {
      position: absolute;
      display: block;
      border-radius: 999px;
      box-shadow: 0 0 18px rgba(0, 92, 255, 0.7);

      &--big {
        width: 32px;
        height: 32px;
        border-radius: 4px;
        border: 1px solid #005cff;
        transform: rotate(45deg);
        animation: hero-sparkle 2.4s ease-in-out infinite;
      }

      &--medium {
        width: 20px;
        height: 20px;
        border-radius: 4px;
        border: 2px solid #005cff;
        transform: rotate(45deg);
        top: -26px;
        left: -20px;
        animation: hero-sparkle 2.6s ease-in-out infinite;
      }

      &--small {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        border: 2px solid #005cff;
        transform: rotate(45deg);
        top: 24px;
        left: 18px;
        animation: hero-sparkle 2.2s ease-in-out infinite;
      }
    }

    &__node {
      position: absolute;
      padding: 6px 16px;
      border-radius: 999px;
      border: 2px solid #005cff;
      background: #ffffff;
      color: #0050c8;
      font-weight: 600;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.2;
      filter: blur(1.5px);
      transform: translate(-5%, -40%);
      transition:
        opacity 0.5s ease,
        filter 0.5s ease,
        transform 0.5s ease,
        box-shadow 0.5s ease;

      &::before {
        content: '';
        position: absolute;
        right: 100%;
        margin-right: 10px;
        width: 25px;
        height: 25px;
        background: linear-gradient(145deg, #00329f, #0d6bff);
        transform: rotate(90deg);
        border-radius: 4px;

        /* Hexágono */
        clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
        /* Sin glow inicial, lo manejamos con animación */
        box-shadow: 0 0 0 0 rgba(5, 69, 200, 0);
      }

      &--conecta {
        top: 45%;
        left: 26%;

        &::before {
          right: -50%;
          bottom: 10%;
          margin-right: 10px;
        }
      }

      &--gestiona {
        top: 19%;
        left: 55%;
      }

      &--optimiza {
        top: 38%;
        left: 68%;
      }

      &--actua {
        top: 71%;
        left: 84%;
      }

      &--active {
        opacity: 1;
        filter: blur(0);
        transform: translate(5%, -50%) scale(0.9);

        /* Glow resplandeciente de 3 segundos en el hexágono */
        &::before {
          animation: hero-hex-glow 3s ease-out forwards;
        }
      }
    }

    &__search {
      position: absolute;
      left: 43%;
      bottom: 20%;
      transform: translate(-50%, 0);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75em 1em;
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.92);
      box-shadow: 0 20px 35px rgba(0, 40, 120, 0.22);
      backdrop-filter: blur(18px);
      transition:
        opacity 0.6s ease,
        transform 0.6s ease;
      opacity: 1;
      width: 68%;
      font-size: smaller;

      &--hidden {
        opacity: 0;
        transform: translate(-50%, 26px);
        pointer-events: none;
      }
    }

    &__search-input {
      width: clamp(250px, 35vw, 500px);
      height: 40px;
      padding: 0 16px;
      border-radius: 999px;
      border: none;
      font-size: 0.75rem;
      width: 100%;
      color: var(--c-quinary);
      outline: none;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.02);

      &::placeholder {
        color: rgba(16, 32, 64, 0.45);
      }
    }

    &__search-button {
      min-width: 80px;
      height: 40px;
      border-radius: 10px;
      border: none;
      padding: 0 1em;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      font-size: 0.75rem;
      color: #ffffff;
      background: linear-gradient(135deg, #005cff, #8a2dfc);
      cursor: default;
    }
  }

  html[data-theme='dark'] .hero {
    .hero__search {
      background: var(--c-quinary);

      &-input {
        color: var(--c-tertiary);
      }
    }

    .hero__node {
      background: transparent;
      color: var(--c-tertiary);
    }
  }

  @keyframes hero-sparkle {
    0%,
    100% {
      transform: rotate(45deg) scale(1);
      opacity: 0.7;
    }
    50% {
      transform: rotate(45deg) scale(1.25);
      opacity: 1;
    }
  }

  /* Glow MUY visible del hexágono durante 3 segundos */
  @keyframes hero-hex-glow {
    0% {
      box-shadow: 0 0 0 0 rgba(5, 69, 200, 0);
    }
    20% {
      box-shadow:
        0 0 16px 6px rgba(5, 69, 200, 0.95),
        0 0 28px 10px rgba(5, 69, 200, 0.85);
    }
    60% {
      box-shadow:
        0 0 10px 4px rgba(5, 69, 200, 0.7),
        0 0 20px 8px rgba(5, 69, 200, 0.5);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(5, 69, 200, 0);
    }
  }

  @media (max-width: 768px) {
    .hero {
      &--flow {
        height: 80vh;
      }

      &__node {
        font-size: 0.72rem;
        padding-inline: 16px;

        &--conecta {
          top: 80%;
          left: 40%;
        }
        &--gestiona {
          top: 22%;
          left: 65%;
        }
        &--optimiza {
          top: 20%;
          left: 70%;
        }
        &--actua {
          top: 75%;
          left: 70%;
        }
      }

      &__search {
        bottom: 8%;
        padding-inline: 12px;

        &-input {
          width: clamp(220px, 70vw, 320px);
        }
      }

      &__sparkles {
        left: 18%;
        top: 62%;
      }
    }
  }
</style>
