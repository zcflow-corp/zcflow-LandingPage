---
/**
 * HeroFlow.astro
 * Props:
 * - texts: string[]
 *   Ej: [
 *    "¿Cuál es el saldo de mi cuenta global en USD?",
 *    "¿Cuáles son los clientes que me pagan con retraso?"
 *   ]
 */

const { texts = [] } = Astro.props
---

<section id="hero-flow" class="hero hero--flow" data-phrases={JSON.stringify(texts)}>
  <canvas class="hero__canvas"></canvas>

  <!-- Sparkles decorativos -->
  <div class="hero__sparkles">
    <span class="hero__sparkle hero__sparkle--big"></span>
    <span class="hero__sparkle hero__sparkle--medium"></span>
    <span class="hero__sparkle hero__sparkle--small"></span>
  </div>

  <!-- Nodos -->
  <div class="hero__node hero__node--conecta" data-node="conecta">CONECTA</div>
  <div class="hero__node hero__node--gestiona" data-node="gestiona">GESTIONA</div>
  <div class="hero__node hero__node--optimiza" data-node="optimiza">OPTIMIZA</div>
  <div class="hero__node hero__node--actua" data-node="actua">ACTÚA</div>

  <!-- Buscador -->
  <div class="hero__search hero__search--hidden">
    <input class="hero__search-input" type="text" disabled />
    <button class="hero__search-button"> BOTO </button>
  </div>
</section>

<script>
  ;(function () {
    const root = document.getElementById('hero-flow')
    if (!root) return

    const canvas = root.querySelector('.hero__canvas')
    if (!canvas) return
    const ctx = canvas.getContext('2d')

    // --------- Resize ----------
    let w, h
    function resize() {
      w = canvas.width = root.clientWidth
      h = canvas.height = root.clientHeight
    }
    resize()
    window.addEventListener('resize', resize)

    // --------- Líneas curvas animadas (fondo transparente) ----------
    let t = 0
    function drawFlow() {
      ctx.clearRect(0, 0, w, h)

      const lines = 20
      for (let i = 0; i < lines; i++) {
        ctx.beginPath()
        const hue = 215 + i * 2
        const light = 40 + i * 0.6
        ctx.strokeStyle = `hsl(${hue}, 90%, ${light}%)`
        ctx.lineWidth = 1.1

        for (let x = 0; x <= w; x += 4) {
          const progress = x / w
          const amplitude = 160 + i * 3
          const phase = t * 0.03 + i * 0.25

          const baseY = h * (0.2 + 0.6 * progress)
          const offsetY = Math.sin(progress * 6 + phase) * amplitude

          const y = baseY + offsetY

          if (x === 0) ctx.moveTo(x, y)
          else ctx.lineTo(x, y)
        }

        ctx.stroke()
      }

      t += 1
      requestAnimationFrame(drawFlow)
    }
    drawFlow()

    // --------- Secuencia de nodos ----------
    const nodeKeys = ['conecta', 'gestiona', 'optimiza', 'actua']
    const nodes = nodeKeys.map((key) => root.querySelector(`[data-node="${key}"]`))

    function activateNode(index) {
      if (!nodes[index]) return
      nodes[index].classList.add('hero__node--active')
    }

    const searchBox = root.querySelector('.hero__search')
    const input = root.querySelector('.hero__search-input')

    async function startSequence() {
      // conecta
      activateNode(0)
      await new Promise((r) => setTimeout(r, 1200))
      // gestiona
      activateNode(1)
      await new Promise((r) => setTimeout(r, 1200))
      // optimiza
      activateNode(2)
      await new Promise((r) => setTimeout(r, 1200))
      // actua
      activateNode(3)

      // mostrar buscador
      setTimeout(() => {
        if (searchBox) {
          searchBox.classList.remove('hero__search--hidden')
          startTypewriter()
        }
      }, 900)
    }

    // --------- Máquina de escribir ----------
    const rawPhrases = root.dataset.phrases || '[]'
    let phrases
    try {
      phrases = JSON.parse(rawPhrases)
    } catch {
      phrases = []
    }

    let pIndex = 0
    let charIndex = 0

    function typePhrase() {
      if (!input || !phrases.length) return

      const phrase = phrases[pIndex]
      if (charIndex < phrase.length) {
        input.value += phrase.charAt(charIndex)
        charIndex++
        setTimeout(typePhrase, 45)
      } else {
        setTimeout(deletePhrase, 1000)
      }
    }

    function deletePhrase() {
      if (!input || !phrases.length) return

      if (charIndex > 0) {
        input.value = input.value.slice(0, -1)
        charIndex--
        setTimeout(deletePhrase, 20)
      } else {
        pIndex = (pIndex + 1) % phrases.length
        setTimeout(typePhrase, 450)
      }
    }

    function startTypewriter() {
      if (!phrases.length) return
      input.value = ''
      pIndex = 0
      charIndex = 0
      typePhrase()
    }

    startSequence()
  })()
</script>

<style lang="scss">
  .hero {
    &--flow {
      position: relative;
      width: 100%;
      height: 100vh;
      min-height: 520px;
      overflow: hidden;
      background: transparent; // fondo de la sección transparente
    }

    &__canvas {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: transparent; // canvas también transparente
    }

    // Sparkles (izquierda, como en la referencia)
    &__sparkles {
      position: absolute;
      left: 12%;
      top: 55%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    &__sparkle {
      position: absolute;
      display: block;
      border-radius: 999px;
      box-shadow: 0 0 18px rgba(0, 92, 255, 0.7);

      &--big {
        width: 32px;
        height: 32px;
        border-radius: 4px;
        border: 2px solid #005cff;
        transform: rotate(45deg);
        animation: hero-sparkle 2.4s ease-in-out infinite;
      }

      &--medium {
        width: 20px;
        height: 20px;
        border-radius: 4px;
        border: 2px solid #005cff;
        transform: rotate(45deg);
        top: -26px;
        left: -20px;
        animation: hero-sparkle 2.6s ease-in-out infinite;
      }

      &--small {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        border: 2px solid #005cff;
        transform: rotate(45deg);
        top: 24px;
        left: 18px;
        animation: hero-sparkle 2.2s ease-in-out infinite;
      }
    }

    &__node {
      position: absolute;
      padding: 6px 22px;
      border-radius: 999px;
      border: 2px solid #005cff;
      background: #ffffff;
      color: #0050c8;
      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        'Segoe UI',
        sans-serif;
      font-weight: 600;
      font-size: 0.82rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.2;
      filter: blur(1.5px);
      transform: translate(-50%, -50%);
      transition:
        opacity 0.5s ease,
        filter 0.5s ease,
        transform 0.5s ease,
        box-shadow 0.5s ease;

      &::before {
        content: '';
        position: absolute;
        right: 100%;
        margin-right: 10px;
        width: 18px;
        height: 18px;
        border-radius: 6px;
        background: linear-gradient(145deg, #005cff, #2e65ff);
        box-shadow: 0 0 10px rgba(0, 92, 255, 0.65);
      }

      &--conecta {
        top: 56%;
        left: 31%;
      }

      &--gestiona {
        top: 27%;
        left: 63%;
      }

      &--optimiza {
        top: 47%;
        left: 77%;
      }

      &--actua {
        top: 74%;
        left: 77%;
      }

      &--active {
        opacity: 1;
        filter: blur(0);
        transform: translate(-50%, -50%) scale(1.06);
        box-shadow: 0 0 16px rgba(0, 92, 255, 0.55);
      }
    }

    &__search {
      position: absolute;
      left: 50%;
      bottom: 12%;
      transform: translate(-50%, 0);
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.92);
      box-shadow: 0 20px 35px rgba(0, 40, 120, 0.22);
      backdrop-filter: blur(18px);
      transition:
        opacity 0.6s ease,
        transform 0.6s ease;
      opacity: 1;

      &--hidden {
        opacity: 0;
        transform: translate(-50%, 26px);
        pointer-events: none;
      }
    }

    &__search-input {
      width: clamp(260px, 40vw, 560px);
      height: 46px;
      padding: 0 18px;
      border-radius: 999px;
      border: none;
      font-size: 0.96rem;
      color: #102040;
      outline: none;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.02);

      &::placeholder {
        color: rgba(16, 32, 64, 0.45);
      }
    }

    &__search-button {
      min-width: 90px;
      height: 46px;
      border-radius: 999px;
      border: none;
      padding: 0 22px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.78rem;
      color: #ffffff;
      background: linear-gradient(135deg, #005cff, #8a2dfc);
      box-shadow: 0 10px 18px rgba(0, 92, 255, 0.45);
      cursor: default;
    }
  }

  @keyframes hero-sparkle {
    0%,
    100% {
      transform: rotate(45deg) scale(1);
      opacity: 0.7;
    }
    50% {
      transform: rotate(45deg) scale(1.25);
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .hero {
      &--flow {
        height: 80vh;
      }

      &__node {
        font-size: 0.72rem;
        padding-inline: 16px;

        &--conecta {
          top: 60%;
          left: 40%;
        }
        &--gestiona {
          top: 22%;
          left: 65%;
        }
        &--optimiza {
          top: 42%;
          left: 78%;
        }
        &--actua {
          top: 75%;
          left: 70%;
        }
      }

      &__search {
        bottom: 8%;
        padding-inline: 12px;

        &-input {
          width: clamp(220px, 70vw, 320px);
        }
      }

      &__sparkles {
        left: 18%;
        top: 62%;
      }
    }
  }
</style>
