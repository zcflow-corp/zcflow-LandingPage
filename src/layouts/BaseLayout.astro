---
import '@/styles/tokens.scss'
import '@/styles/globals.scss'
import '@/styles/buttons.scss'
import '@/styles/components.scss'
// import '@/styles/mixins.scss'  .. estos se importa en astro.config.msj porque tienen mixins

interface BaseLayoutProps {
  title?: string
  description?: string
}

const {
  title = 'Automatización de tesorería para CFOs | Zcflow',
  description = 'Plataforma fintech que automatiza la tesorería, mejora la liquidez y ofrece previsión financiera en tiempo real con IA.',
} = Astro.props as BaseLayoutProps
const base = import.meta.env.BASE_URL
const url = Astro.site?.toString() ?? 'http://localhost:4321/'
const locale = Astro.currentLocale || 'es_ES'
const ogImage = `${base}assets/logo_header_light.webp`
---

<!--
  Meta tags y estructura optimizada siguiendo guías oficiales de SEO y accesibilidad:
  - Google SEO: https://developers.google.com/search/docs
  - WCAG: https://www.w3.org/WAI/WCAG21/quickref/
-->
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- SEO básico -->
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#141417" />
    <link rel="canonical" href={url} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Redes sociales -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={locale} />

    <!-- Favicon -->
    <link rel="icon" href=`${base}img/favicon.ico` />

    <!-- Fonts-->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap"
      as="style"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Tema dark/light sin flash o parpadeo visual -->
    <script>
      try {
        const t = localStorage.getItem('tema_activo') || 'light'
        document.documentElement.setAttribute('data-theme', t)
      } catch {}
    </script>
    {
      /*sameAs: agregar cuando tenga redes sociales verificables 
    por ejemplo sameAs: ['https://www.linkedin.com/company/zcflow'] 
    */
    }
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Zcflow',
        url: url,
        logo: `${url}/logo.png`,
      })}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
